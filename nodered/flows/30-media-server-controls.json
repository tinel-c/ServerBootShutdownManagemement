    {
        "id": "func_media_enrich_cmd",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Enrich media MQTT command",
        "func": "let p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (e) { p = {}; }\n}\np = Object.assign({}, p);\nif (!p.request_id) p.request_id = 'nr-media-' + Date.now();\nif (!p.timestamp) p.timestamp = new Date().toISOString();\nmsg.payload = p;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 480,
        "wires": [["mqtt_out_media"]]
    },
    {
        "id": "mqtt_out_media",
        "type": "mqtt out",
        "z": "tab_dashboard",
        "name": "Media Server Command",
        "topic": "",
        "qos": "1",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt_broker_local",
        "x": 700,
        "y": 480,
        "wires": []
    },
    {
        "id": "mqtt_in_media_response",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Media Command Response",
        "topic": "media/server/response",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 180,
        "y": 740,
        "wires": [["func_media_format_response"]]
    },
    {
        "id": "func_media_format_response",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Format media command response",
        "func": "const r = msg.payload || {};\nconst ok = !!r.success;\nconst action = r.action || 'command';\nconst emoji = ok ? '✅' : '❌';\n\nreturn {\n    payload: `${emoji} Media Server ${action}: ${r.message || (ok ? 'OK' : 'Failed')}`\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 740,
        "wires": [["ui_notification_media"]]
    },
