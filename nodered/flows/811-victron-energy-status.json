[
    {
        "id": "victron_energy_comment",
        "type": "comment",
        "z": "tab_dashboard",
        "name": "═══════════════ VICTRON ENERGY STATUS DASHBOARD ═══════════════",
        "info": "## Victron Energy Status Dashboard\n\n**Flow 811** — live metrics, 7-day chart, discretionary load commands.\n\n### MQTT subscribe\n- `energy/victron/status`\n- `energy/victron/forecast/solar/current`\n- `energy/victron/forecast/solar/daily`\n\n### MQTT publish (dashboard buttons)\n- `energy/victron/command/discretionary/start`\n- `energy/victron/command/discretionary/stop`\n- `energy/victron/automation/discretionary_load/state` (retained)\n\nSee [docs/ENERGY_NODE_RED.md](../../docs/ENERGY_NODE_RED.md).",
        "x": 320,
        "y": 40,
        "wires": []
    },
    {
        "id": "mqtt_in_victron_status",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Victron Status",
        "topic": "energy/victron/status",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 180,
        "y": 140,
        "wires": [
            [
                "func_victron_process_status"
            ]
        ]
    },
    {
        "id": "func_victron_process_status",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Process Victron Status",
        "func": "const data = msg.payload;\nif (!data || typeof data !== 'object' || !data.timestamp) {\n    node.warn('Invalid Victron status payload');\n    return null;\n}\n\nconst receivedMs = Date.now();\nlet reportMs;\ntry {\n    reportMs = new Date(data.timestamp).getTime();\n} catch (e) {\n    reportMs = receivedMs;\n}\n\nflow.set('last_victron_status', data);\nconst forecast = flow.get('victron_solar_forecast');\nif (forecast) data.forecast_solar = forecast;\nconst forecastDaily = flow.get('victron_solar_forecast_daily');\nif (forecastDaily) data.forecast_daily = forecastDaily;\n\nconst WEEK_MS = 7 * 24 * 60 * 60 * 1000;\nconst BUCKET_MS = 15 * 60 * 1000;\nconst auto = data.automation || {};\nconst point = {\n    t: reportMs,\n    soc: data.battery?.soc_pct,\n    grid: data.grid?.power_l1_w,\n    pv: auto.pv_power_w ?? data.pv?.ac_output_l1_w,\n    load: data.load?.consumption_l1_w,\n    battP: data.battery?.power_w,\n    headroom: auto.headroom_w,\n    invOut: data.inverter?.ac_out_power_l1_w,\n    invIn: data.inverter?.ac_in_power_l1_w,\n    dcV: data.inverter?.dc_voltage_v\n};\nlet hist = flow.get('victron_week_history') || [];\nconst bucket = Math.floor(reportMs / BUCKET_MS) * BUCKET_MS;\nif (hist.length && hist[hist.length - 1].bucket === bucket) {\n    hist[hist.length - 1] = { bucket, ...point };\n} else {\n    hist.push({ bucket, ...point });\n}\nconst cutoff = Date.now() - WEEK_MS;\nhist = hist.filter(h => h.t >= cutoff);\nflow.set('victron_week_history', hist);\ndata.week_chart = hist;\ndata.discretionary_load = flow.get('victron_discretionary_load') || { enabled: false, updated_at: null, source: null };\n\nglobal.set('victron_energy_state', {\n    ...data,\n    lastReportedMs: reportMs,\n    receivedAtMs: receivedMs\n});\n\nconst metaKey = 'victron_energy_metadata';\nlet meta = flow.get(metaKey) || {\n    lastReportedMs: null,\n    lastInverterState: 'Unknown',\n    previousInverterState: 'Unknown',\n    lastChangedMs: null\n};\nmeta.lastReportedMs = reportMs;\nconst invState = (data.inverter && data.inverter.state) ? data.inverter.state : 'Unknown';\nif (invState !== meta.lastInverterState) {\n    meta.previousInverterState = meta.lastInverterState;\n    meta.lastInverterState = invState;\n    meta.lastChangedMs = reportMs;\n}\nflow.set(metaKey, meta);\nmsg.payload = data;\nmsg.metadata = meta;\n\nconst soc = data.battery && data.battery.soc_pct;\nnode.status({ fill: auto.can_add_load ? 'green' : 'yellow', shape: 'dot', text: `SoC ${soc != null ? soc : '?'}% | headroom ${auto.headroom_w != null ? auto.headroom_w : '?'}W` });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 140,
        "wires": [
            [
                "template_victron_energy_dashboard"
            ]
        ]
    },
    {
        "id": "mqtt_in_victron_forecast",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Solar Forecast Current",
        "topic": "energy/victron/forecast/solar/current",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 220,
        "wires": [
            [
                "func_victron_store_forecast"
            ]
        ]
    },
    {
        "id": "func_victron_store_forecast",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Store Solar Forecast",
        "func": "if (!msg.payload || typeof msg.payload !== 'object') return null;\nflow.set('victron_solar_forecast', msg.payload);\nconst last = flow.get('last_victron_status');\nif (!last) return null;\nconst meta = flow.get('victron_energy_metadata') || {};\nconst daily = flow.get('victron_solar_forecast_daily');\nreturn { payload: { ...last, forecast_solar: msg.payload, forecast_daily: daily || null, week_chart: flow.get('victron_week_history') || [], discretionary_load: flow.get('victron_discretionary_load') || { enabled: false } }, metadata: meta };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 220,
        "wires": [
            [
                "template_victron_energy_dashboard"
            ]
        ]
    },
    {
        "id": "mqtt_in_victron_forecast_daily",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Solar Forecast Daily",
        "topic": "energy/victron/forecast/solar/daily",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 280,
        "wires": [
            [
                "func_victron_store_forecast_daily"
            ]
        ]
    },
    {
        "id": "func_victron_store_forecast_daily",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Store Daily Forecast",
        "func": "if (!msg.payload || typeof msg.payload !== 'object') return null;\nflow.set('victron_solar_forecast_daily', msg.payload);\nconst last = flow.get('last_victron_status');\nif (!last) return null;\nconst meta = flow.get('victron_energy_metadata') || {};\nconst current = flow.get('victron_solar_forecast');\nreturn { payload: { ...last, forecast_solar: current || null, forecast_daily: msg.payload, week_chart: flow.get('victron_week_history') || [], discretionary_load: flow.get('victron_discretionary_load') || { enabled: false } }, metadata: meta };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 280,
        "wires": [
            [
                "template_victron_energy_dashboard"
            ]
        ]
    },
    {
        "id": "inject_victron_refresh",
