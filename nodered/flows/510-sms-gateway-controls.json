    {
        "id": "func_prepare_sms_command",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Prepare SMS Command",
        "func": "// Get phone and message from flow context (set by text inputs)\nlet phone = flow.get('sms_phone') || '';\nconst message = flow.get('sms_message') || '';\n\nif (!phone || !message) {\n    node.warn('Phone number or message missing');\n    return null;\n}\n\n// Strip all non-digits for MQTT (gateway expects digits-only in 'to')\nphone = String(phone).replace(/\\D/g, '');\n\n// Create SMS command payload (JSON string for gateway)\nmsg.payload = JSON.stringify({ to: phone, text: message });\nmsg.topic = 'sms/gateway/command/send';\n\n// Store timestamp for tracking\nmsg.timestamp = new Date().toISOString();\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 220,
        "wires": [
            [
                "mqtt_out_sms_command"
            ]
        ]
    },
