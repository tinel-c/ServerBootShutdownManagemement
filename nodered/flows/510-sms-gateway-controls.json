    {
        "id": "func_format_sms_response",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Format SMS Response",
        "func": "// Format response for UI notification\nconst response = msg.payload;\nconst success = response.success || false;\nconst phone = response.to || 'Unknown';\nconst timestamp = response.timestamp || new Date().toISOString();\n\nconst emoji = success ? '✅' : '❌';\nconst status = success ? 'Success' : 'Failed';\n\nmsg.payload = {\n    success: success,\n    phone: phone,\n    timestamp: timestamp,\n    message: `${emoji} SMS ${status} to ${phone}`\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
