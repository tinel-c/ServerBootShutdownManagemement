[Unit]
Description=HealthChecks.io Status Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dell_server_management
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/dell_server_management/venv/bin/python3 /opt/dell_server_management/scripts/status/health_monitor.py
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
