# Energy consumer monitoring — global configuration
# Copy to config/.env (gitignored).

# MQTT broker (defaults to main automation broker)
MQTT_BROKER_HOST=192.168.2.4
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Topic prefix for all consumers (each device also has energy/consumers/<id>/…)
ENERGY_CONSUMERS_MQTT_PREFIX=energy/consumers

# Registry file (relative to device/energy-consumers/ or absolute path)
ENERGY_CONSUMERS_REGISTRY=config/consumers_registry.yaml

# Default publish interval hint for pollers (seconds)
ENERGY_CONSUMERS_DEFAULT_INTERVAL=30

# Stale threshold: status older than this is treated offline in aggregators (seconds)
ENERGY_CONSUMERS_STALE_SECONDS=180
