[
    {
        "id": "sms_status_comment",
        "type": "comment",
        "z": "tab_dashboard",
        "name": "═══════════════ SMS GATEWAY STATUS & LOGGING ═══════════════",
        "info": "## SMS Gateway Status & Message Logging\n\n**Flow Number:** 511\n**Domain:** SMS/Notifications (500-599)\n\n### Purpose\nMonitors SMS Gateway status and logs all received SMS messages.\n\n### Features\n- Real-time SMS message logging\n- Message history display\n- Status monitoring\n- Timestamp tracking\n\n### MQTT Topics\n- Receive From: sms/gateway/receive/from\n- Receive Text: sms/gateway/receive/text\n- Receive Timestamp: sms/gateway/receive/timestamp\n- Status: sms/gateway/status\n\n### Dependencies\n- ui_group_sms_logs (from 00-base-config.json)\n- mqtt_broker_local",
        "x": 300,
        "y": 40,
        "wires": []
    },
