    {
        "id": "gate_main_error_log",
        "type": "function",
        "z": "gate_main_tab",
        "name": "Log Error",
        "func": "const error = {\n    timestamp: new Date().toISOString(),\n    level: 'ERROR',\n    domain: 'gate',\n    feature: 'main-gate-controls',\n    message: msg.error?.message || 'Unknown error',\n    stack: msg.error?.stack\n};\n\nnode.error(JSON.stringify(error));\n\nmsg.payload = error;\nmsg.topic = 'system/logs';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
