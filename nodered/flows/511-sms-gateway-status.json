    {
        "id": "template_sms_log",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_sms_logs",
        "name": "SMS Messages Log",
        "order": 7,
        "width": 0,
        "height": 0,
        "format": "<div class=\"sx-card\">\r\n    <div class=\"sx-head\">\r\n        <div>\r\n            <div class=\"sx-kicker\">Inbox</div>\r\n            <h3 class=\"sx-title\">Received messages</h3>\r\n        </div>\r\n        <div class=\"sx-head\" style=\"align-items: center;\">\r\n            <div class=\"sx-count\">{{ (msg.payload && msg.payload.messageCount) || 0 }}</div>\r\n            <button type=\"button\" class=\"sx-btn sx-btn-ghost\" @click=\"clearLog\">Clear</button>\r\n        </div>\r\n    </div>\r\n\r\n    <div v-if=\"!msg.payload || !msg.payload.messageCount\" class=\"sx-empty\">No messages received yet</div>\r\n\r\n    <div v-else class=\"sx-scroll\">\r\n        <div v-for=\"(item, index) in msg.payload.messages\" :key=\"index\" class=\"sx-msg\" :class=\"{ 'is-new': index === 0 }\">\r\n            <div class=\"sx-msg-top\">\r\n                <div class=\"sx-from\">\r\n                    <span>{{ item.from }}</span>\r\n                    <span v-if=\"index === 0\" class=\"sx-badge\">New</span>\r\n                </div>\r\n                <span class=\"sx-time\">{{ formatTime(item.timestamp) }}</span>\r\n            </div>\r\n            <div class=\"sx-body\">{{ item.text }}</div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\nexport default {\r\n    methods: {\r\n        formatTime(timestamp) {\r\n            if (!timestamp) return 'Unknown';\r\n            try {\r\n                const date = new Date(timestamp);\r\n                const now = new Date();\r\n                const diffSec = Math.floor((now - date) / 1000);\r\n                if (diffSec < 60) return `${diffSec}s ago`;\r\n                if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;\r\n                if (diffSec < 86400) return `${Math.floor(diffSec / 3600)}h ago`;\r\n                return date.toLocaleString();\r\n            } catch (e) {\r\n                return timestamp;\r\n            }\r\n        },\r\n        clearLog() {\r\n            this.$send({ payload: { action: 'clear' } });\r\n        }\r\n    }\r\n}\r\n</script>\r\n",
        "storeOutMessages": true,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "sms-log",
        "x": 640,
        "y": 180,
        "wires": [
            [
                "func_clear_sms_log"
            ]
        ],
        "passthru": false
    },
