# Huawei SUN2000 inverter — local configuration template
# Copy to config/.env and adjust for your installation (config/.env is gitignored).

# --- Connection mode: wifi_ap (USB WiFi → inverter AP) or sdongle_lan ---
HUAWEI_CONNECTION_MODE=wifi_ap

# USB WiFi on automation server (192.168.2.4) joins the inverter AP
# SSID pattern: SUN2000-<serial>  |  default AP password is often Changeme
HUAWEI_WIFI_SSID=SUN2000-xxxxxxxx
HUAWEI_WIFI_PASSWORD=your_ap_password
# Server USB WiFi interface (run `ip -br link` on the server)
HUAWEI_WIFI_IFACE=wlxec750caf06b1

# Modbus when connected via inverter WiFi AP (typical defaults)
HUAWEI_INVERTER_HOST=192.168.200.1
HUAWEI_MODBUS_PORT=6607
# AP mode unit ID is usually 0; SDongle on LAN is usually 1
HUAWEI_MODBUS_UNIT_ID=0
HUAWEI_MODBUS_CONNECT_WAIT=2

# SDongle on LAN (alternative — set HUAWEI_CONNECTION_MODE=sdongle_lan)
# HUAWEI_INVERTER_HOST=192.168.x.x
# HUAWEI_MODBUS_PORT=502
# HUAWEI_MODBUS_UNIT_ID=1

# Optional: device label for logs and MQTT metadata
# HUAWEI_DEVICE_NAME=sun2000-roof

# Bridge target (this repo's automation MQTT broker on main LAN)
MQTT_BROKER_HOST=192.168.2.4
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Publisher settings
HUAWEI_MQTT_PREFIX=energy/huawei
HUAWEI_MODBUS_POLL_INTERVAL=10
HUAWEI_MQTT_QOS=1

# Automation: discretionary load headroom (planned — mirror Victron workflow)
# HUAWEI_AUTOMATION_MIN_HEADROOM_W=500

# Solar forecast (Open-Meteo) — same site as Victron integration
HUAWEI_FORECAST_LAT=47.0966
HUAWEI_FORECAST_LON=27.5632
HUAWEI_FORECAST_LOCATION="Lunca Cetătui, Iași, RO"
HUAWEI_FORECAST_TIMEZONE=Europe/Bucharest
HUAWEI_FORECAST_POLL_INTERVAL=1800
HUAWEI_FORECAST_DAYS=3
HUAWEI_FORECAST_HOURLY_HOURS=48
