# HealthChecks.io Configuration
HEALTHCHECKS_API_KEY=hcr_mOx7fm5xxxxxxxxxxxxxxxxxx
T310_HEALTHCHECKS="nextcloud"
DL360P_HEALTHCHECKS="dl360p_server"

# MQTT Broker Configuration
# Linux automation server / SSH target
MQTT_BROKER_HOST=192.168.2.4
MQTT_BROKER_PORT=1883
MQTT_USERNAME=dell_server_mgmt
MQTT_PASSWORD=your_mqtt_password_here

# Dell T310 IPMI Credentials
T310_IPMI_HOST=192.168.1.100
T310_IPMI_USERNAME=admin
T310_IPMI_PASSWORD=your_t310_ipmi_password_here

# Dell T310 Proxmox Credentials
T310_PROXMOX_HOST=192.168.1.100
T310_PROXMOX_USERNAME=root@pam
T310_PROXMOX_PASSWORD=your_t310_proxmox_password_here

# HP DL360p iLO Credentials
DL360P_ILO_HOST=192.168.1.101
DL360P_ILO_USERNAME=Administrator
DL360P_ILO_PASSWORD=your_dl360p_ilo_password_here

# HP DL360p Proxmox Credentials
DL360P_PROXMOX_HOST=192.168.1.101
DL360P_PROXMOX_USERNAME=root@pam
DL360P_PROXMOX_PASSWORD=your_dl360p_proxmox_password_here

# Server MAC Addresses
T310_MAC_ADDRESS=00:11:22:33:44:55
DL360P_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# Tapo Camera Configuration (Dynamic pattern: CAMERA_N_...)
# You can add multiple cameras by incrementing the index (CAMERA_2_..., CAMERA_3_...)
CAMERA_1_NAME="Front Gate"
CAMERA_1_IP=192.168.1.50
CAMERA_1_PORT=2020
CAMERA_1_USER=admin
CAMERA_1_PASS=your_camera_password_here
CAMERA_1_MQTT_PREFIX="garden/camera/front"

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/dell_server_management.log

