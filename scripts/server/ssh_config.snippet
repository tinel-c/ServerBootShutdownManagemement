# Optional SSH client snippet — merge manually into ~/.ssh/config if you use a Host alias.
# SSH access to the automation server is a prerequisite; this repo does not install keys for you.

Host serverside
    HostName 192.168.2.4
    User tinel
    IdentityFile ~/.ssh/serverside_192_168_2_4_ed25519
    IdentitiesOnly yes

# Media server — key generated on automation server by setup_media_server_ssh.sh
Host media-server
    HostName 192.168.2.185
    User tinel
    IdentityFile ~/.ssh/media_server_192_168_2_185_ed25519
    IdentitiesOnly yes
