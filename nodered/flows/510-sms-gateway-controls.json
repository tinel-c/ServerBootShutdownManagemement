[
    {
        "id": "sms_gateway_comment",
        "type": "comment",
        "z": "tab_dashboard",
        "name": "═══════════════ SMS GATEWAY CONTROLS ═══════════════",
        "info": "## SMS Gateway Control\n\n**Flow Number:** 510\n**Domain:** SMS/Notifications (500-599)\n\n### Purpose\nProvides control interface for SMS Gateway device to send SMS messages.\n\n### Features\n- Send SMS via Dashboard UI\n- Phone number and message input\n- Real-time status display\n- Send response tracking\n\n### MQTT Topics\n- Command: sms/gateway/command/send\n- Status: sms/gateway/status\n- Response: sms/gateway/send/response\n\n### Dependencies\n- ui_group_sms_gateway (from 00-base-config.json)\n- mqtt_broker_local",
        "x": 280,
        "y": 40,
        "wires": []
    },
    {
        "id": "ui_text_sms_allowed_phones",
        "type": "ui-text-input",
        "z": "tab_dashboard",
        "group": "ui_group_sms_gateway",
        "name": "Allowed phones (SMS commands)",
        "order": 0,
        "width": 0,
        "height": 0,
        "passthru": true,
        "mode": "text",
        "delay": 500,
        "topic": "allowed_phones",
        "label": "Allowed phones (SMS commands)",
        "tooltip": "Comma-separated numbers that can send SMS commands (HELP, GATE_OPEN, etc.). Leave empty to allow all.",
        "place": "e.g. +40123456789, +40987654321. Empty = allow all",
        "format": "{{value}}",
        "className": "",
        "x": 225,
        "y": 60,
        "wires": [
