#!/bin/sh
# Append the project author to every commit message.
# Install: copy this file to .git/hooks/prepare-commit-msg (Git runs it; no git config change).

MSG_FILE=$1
TRAILER="Co-authored-by: Constantin Bogza <tinel.c@gmail.com>"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

if grep -q "Co-authored-by: Constantin Bogza" "$MSG_FILE"; then
  exit 0
fi

printf "\n%s\n" "$TRAILER" >> "$MSG_FILE"
