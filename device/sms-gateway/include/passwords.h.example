#ifndef PASSWORDS_H
#define PASSWORDS_H

// WiFi credentials (if using WiFi instead of GPRS)
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// MQTT Broker configuration
const char* mqtt_server = "YOUR_MQTT_BROKER_IP";  // e.g., "192.168.1.100"
const int mqtt_port = 1883;
const char* mqtt_username = "YOUR_MQTT_USERNAME";
const char* mqtt_password = "YOUR_MQTT_PASSWORD";

// MQTT Client ID
const char* mqtt_client_id = "esp32-sms-gateway";

// GPRS/APN configuration
const char apn[] = "net";  // Your mobile network APN
const char user[] = "";    // APN username (if required)
const char pass[] = "";    // APN password (if required)

// Emergency SMS notification
// Phone number to receive alerts when WiFi/MQTT fails (include country code, e.g., "+1234567890")
#define EMERGENCY_PHONE_NUMBER ""  // Leave empty to disable emergency SMS

// OTA (Over-The-Air) update password
// Set a password to secure OTA updates (optional but recommended)
#define OTA_PASSWORD ""  // Leave empty to disable password protection

#endif
