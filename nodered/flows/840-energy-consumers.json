            [
                "func_consumers_fan_out"
            ]
        ]
    },
    {
        "id": "func_consumers_fan_out",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Fan-out consumer UIs",
        "func": "const ids = [\"front-lights-breaker\",\"breaker-inside\",\"breaker-outside\",\"garden-power-hut\"];\nfunction enrich(id) {\n  const payload = flow.get('consumer_status_' + id) || { consumer_id: id, name: id, online: false };\n  const metadata = flow.get('consumer_meta_' + id) || {};\n  let fetchedMs = metadata.lastReportedMs;\n  if (!fetchedMs && payload.timestamp) {\n    try { fetchedMs = new Date(payload.timestamp).getTime(); } catch (e) { fetchedMs = null; }\n  }\n  const enriched = fetchedMs ? { ...payload, _fetched_at_ms: fetchedMs } : payload;\n  return { payload: enriched, metadata };\n}\nreturn ids.map(id => [enrich(id)]);",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 1040,
        "wires": [
            [
                [
                    "template_consumer_front_lights_breaker"
                ]
            ],
            [
                [
                    "template_consumer_breaker_inside"
                ]
            ],
            [
                [
                    "template_consumer_breaker_outside"
                ]
            ],
            [
                [
                    "template_consumer_garden_power_hut"
                ]
            ]
        ]
    },
    {
        "id": "func_consumer_switch_cmd",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Route consumer switch cmd",
        "func": "const p = msg.payload;\nif (!p || typeof p !== 'object' || !p.action) return null;\nconst id = p.consumer_id;\nif (!id) return null;\nreturn {\n  topic: 'energy/consumers/' + id + '/command/switch',\n  payload: p\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 1120,
        "wires": [
            [
                "mqtt_out_consumer_cmd"
            ]
        ]
    },
