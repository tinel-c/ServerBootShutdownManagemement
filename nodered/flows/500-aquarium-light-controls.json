    {
        "id": "aquarium_init_function",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Init Global Context",
        "func": "if (!global.get('aquarium_state')) {\n    global.set('aquarium_state', {\n        light_power: 'UNKNOWN',\n        lastUpdate: new Date().toISOString()\n    });\n    node.warn('Initialized aquarium_state in global context');\n} else {\n    node.warn('aquarium_state already exists in global context');\n}\nreturn null;",
