        "name": "Rolling Log",
        "order": 1,
        "width": "12",
        "height": "6",
        "format": "<div id=\"log-console\" style=\"background-color: #1a1a1a; color: #00ff00; font-family: monospace; padding: 10px; height: 100%; overflow-y: scroll;\">\n    <div ng-repeat=\"line in msg.payload | limitTo: -20 track by $index\">\n        <span style=\"color: #888;\">[{{line.timestamp}}]</span> \n        <span style=\"color: #fff;\">[{{line.action}}]</span> \n        <span ng-class=\"{'text-success': line.success, 'text-danger': !line.success}\">{{line.message}}</span>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 490,
        "y": 580,
