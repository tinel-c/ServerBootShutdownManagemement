    {
        "id": "func_store_sms_timestamp",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Process Complete SMS",
        "func": "// All three parts received, combine into complete SMS message\nconst from = flow.get('sms_current_from') || 'Unknown';\nconst text = flow.get('sms_current_text') || '';\nconst timestamp = msg.payload || new Date().toISOString();\n\n// Create complete SMS message object\nconst smsMessage = {\n    from: from,\n    text: text,\n    timestamp: timestamp,\n    receivedAt: new Date().toISOString()\n};\n\n// Get message log from flow context\nlet messageLog = flow.get('sms_message_log') || [];\n\n// Add to log (keep last 100 messages)\nmessageLog.unshift(smsMessage);\nif (messageLog.length > 100) {\n    messageLog = messageLog.slice(0, 100);\n}\n\n// Store updated log\nflow.set('sms_message_log', messageLog);\n\n// Clear temporary storage\nflow.set('sms_current_from', null);\nflow.set('sms_current_text', null);\n\n// Prepare message for UI and MQTT\nmsg.payload = {\n    messages: messageLog,\n    messageCount: messageLog.length,\n    latest: smsMessage\n};\n\nnode.status({fill: \"green\", shape: \"dot\", text: `${messageLog.length} messages`});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [
            [
                "template_sms_log",
                "func_publish_sms_received",
                "func_forward_sms_emergency"
            ]
        ]
    },
