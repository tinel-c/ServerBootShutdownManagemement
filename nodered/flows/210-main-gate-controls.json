[
    {
        "id": "gate_main_comment",
        "type": "comment",
        "z": "gate_main_tab",
        "name": "═══════════════ MAIN GATE CONTROL - Relay 2 ═══════════════",
        "info": "## Main Gate Control\n\nProvides a switch to open/close the main gate.\n\n### How it works:\n1. Subscribe to MainGate/STAT/Relay2 for current state\n2. Display switch in dashboard\n3. When toggled, send 1-second pulse\n4. Publish to MainGate/CMD/Relay2\n5. Log command to flow context\n\n### MQTT Topics:\n- Status: MainGate/STAT/Relay2\n- Command: MainGate/CMD/Relay2\n\n### Dependencies:\n- Requires: 200-gate-base-config.json\n- Requires: ui_group_gate_control\n- Requires: mqtt_broker_local",
        "x": 300,
        "y": 140,
        "wires": []
    },
    {
        "id": "gate_main_mqtt_in_relay2",
        "type": "mqtt in",
        "z": "gate_main_tab",
        "name": "Main Gate Relay 2 Status",
        "topic": "MainGate/STAT/Relay2",
        "qos": "2",
        "datatype": "auto-detect",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": false,
        "rh": 0,
        "inputs": 0,
        "x": 210,
        "y": 220,
        "wires": [
            [
                "gate_main_switch"
            ]
        ]
    },
    {
        "id": "gate_main_switch",
        "type": "ui-switch",
        "z": "gate_main_tab",
