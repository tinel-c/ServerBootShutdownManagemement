    {
        "id": "func_prepare_dashboard_data",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Prepare Dashboard Data",
        "func": "const clients = flow.get('clients') || {};\nconst lastCommand = flow.get('last_command') || {\n    action: \"None\",\n    timestamp: \"--\",\n    details: \"No commands sent yet\"\n};\nconst automationEnabled = flow.get('client_automation_enabled');\nconst deadline = flow.get('shutdown_deadline');\n\nconst metadataKey = \"status_metadata_dell_t310_status\";\nlet metadata = flow.get(metadataKey) || {\n    lastReportedMs: null,\n    lastChangedMs: null,\n    previousState: \"Unknown\",\n    currentState: \"Unknown\"\n};\n\n// --- HEALTH MONITOR LOGIC ---\n// Derived directly from the health payload\nif (msg.payload && msg.payload.checks) {\n    const checks = msg.payload.checks;\n    // Consider server 'up' if any check is 'up', otherwise 'down'\n    const isUp = checks.length > 0 && checks.some(c => c.status === 'up');\n    const newState = isUp ? 'up' : 'down';\n    \n    const nowMs = Date.now();\n    metadata.lastReportedMs = nowMs;\n    if (newState !== metadata.currentState) {\n        metadata.previousState = metadata.currentState;\n        metadata.currentState = newState;\n        metadata.lastChangedMs = nowMs;\n    }\n    flow.set(metadataKey, metadata);\n}\n\nlet countdown = null;\nif (deadline) {\n    const remaining = Math.max(0, Math.floor((new Date(deadline) - new Date()) / 1000));\n    const mins = Math.floor(remaining / 60);\n    const secs = remaining % 60;\n    countdown = `${mins}:${secs.toString().padStart(2, '0')}`;\n}\n\nmsg.payload = {\n    client_count: Object.keys(clients).length,\n    last_command: lastCommand,\n    automation_enabled: automationEnabled !== false,\n    shutdown_countdown: countdown,\n    metadata: metadata,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
