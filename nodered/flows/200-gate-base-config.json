[
    {
        "id": "gate_init",
        "type": "inject",
        "z": "gate_main_tab",
        "name": "Initialize Gate Context",
        "props": [],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "x": 220,
        "y": 100,
        "wires": [
            [
                "gate_init_func"
            ]
        ]
    },
    {
        "id": "gate_init_func",
        "type": "function",
        "z": "gate_main_tab",
        "name": "Setup Gate Context",
        "func": "// Initialize flow context for gate domain\nflow.set('gate_state', {\n    initialized: true,\n    timestamp: new Date().toISOString(),\n    mainGate: {\n        relay1: 'UNKNOWN',\n        relay2: 'UNKNOWN',\n        relay3: 'UNKNOWN',\n        relay4: 'UNKNOWN',\n        power: 'UNKNOWN',\n        mains: 'UNKNOWN',\n        keypad: 'UNKNOWN'\n    },\n    lastCommand: null,\n    commandHistory: []\n});\n\nnode.log('Gate automation domain initialized');\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "gate_comment",
        "type": "comment",
        "z": "gate_main_tab",
        "name": "═══════════════ BASE CONFIGURATION ═══════════════",
        "info": "This is the base configuration for the Gate automation domain.\n\n## Dependencies\n- Requires: 00-base-config.json (MQTT broker, UI base)\n\n## Provides\n- UI page: /gates\n- UI groups for controls, status, relays, debug\n- Context initialization\n- Gate state management\n\n## Next Steps\nAfter importing this, import feature modules:\n- 210-main-gate-controls.json\n- 211-main-gate-status.json\n- 212-main-gate-sensors.json",
        "x": 280,
        "y": 40,
        "wires": []
    },
