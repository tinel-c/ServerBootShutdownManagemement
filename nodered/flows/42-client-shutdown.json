        ]
    },
    {
        "id": "func_sync_clients",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Get Client List",
        "func": "const clients = flow.get('clients') || {};\n\nmsg.payload = {\n    clients: clients,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
