    {
        "id": "func_log_accumulator",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Accumulate Logs",
        "func": "var logs = flow.get(\"dashboard_logs\") || [];\nvar entry = msg.payload;\n\n// Add timestamp if missing\nif (!entry.timestamp) {\n    entry.timestamp = new Date().toLocaleTimeString();\n}\n\n// Infer success if missing\nif (typeof entry.success === 'undefined') {\n    entry.success = !JSON.stringify(entry).toLowerCase().includes('error');\n}\n\nlogs.push(entry);\n\n// Keep last 20\nif (logs.length > 20) {\n    logs = logs.slice(-20);\n}\n\nflow.set(\"dashboard_logs\", logs);\n\n// We must return the ARRAY for the template to loop\nmsg.payload = logs;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 620,
        "wires": [
            [
                "ui_template_logs"
            ]
        ]
    },
    {
        "id": "ui_template_logs",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_logs",
        "name": "Rolling Log",
        "order": 1,
        "width": "12",
        "height": "6",
        "format": "<div id=\"log-console\" style=\"background-color: #1a1a1a; color: #00ff00; font-family: monospace; padding: 10px; height: 100%; overflow-y: scroll;\">\n    <div v-for=\"line in msg.payload.slice().reverse()\" :key=\"line.timestamp\">\n        <span style=\"color: #888;\">[{{line.timestamp}}]</span> \n        <span style=\"color: #fff;\">[{{line.action || 'INFO'}}]</span> \n        <span :class=\"{'text-success': line.success, 'text-danger': !line.success}\">{{line.message || JSON.stringify(line)}}</span>\n    </div>\n</div>\n\n<style>\n.text-success { color: #4caf50; }\n.text-danger { color: #f44336; }\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 520,
        "y": 620,
        "wires": [
            []
        ]
    },
