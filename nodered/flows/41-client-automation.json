    {
        "id": "func_server_shutdown",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Handle Shutdown",
        "func": "const enabled = flow.get('client_automation_enabled');\nif (enabled === false) return null;\n\n// Set shutdown deadline (5 minutes grace period)\nconst GRACE_SECONDS = 300;\nconst deadline = new Date(Date.now() + GRACE_SECONDS * 1000).toISOString();\nflow.set('shutdown_deadline', deadline);\n\nflow.set('last_command', {\n    action: \"Grace Period\",\n    timestamp: new Date().toISOString(),\n    details: \"Shutdown scheduled (last client offline)\"\n});\n\nnode.status({fill: \"yellow\", shape: \"ring\", text: \"Grace period started\"});\nreturn msg;",
