        "id": "func_server_boot",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Handle Boot",
        "func": "const enabled = flow.get('client_automation_enabled');\nif (enabled === false) return null;\n\n// Cancel any pending shutdown\nflow.set('shutdown_deadline', null);\n\nconst now = new Date().toISOString();\nflow.set('last_command', {\n    action: \"Wakeup\",\n    timestamp: now,\n    details: \"First client online (WOL)\"\n});\n\nmsg.payload = { action: \"boot\", method: \"wol\" };\nnode.status({fill: \"green\", shape: \"dot\", text: \"Sending WOL\"});\nreturn msg;",
