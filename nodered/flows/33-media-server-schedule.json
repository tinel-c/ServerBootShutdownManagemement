    {
        "id": "media_sched_ui_template",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "590309fda6555eae",
        "name": "Media Schedule Config",
        "order": 22,
        "width": 0,
        "height": 0,
        "format": "<div style=\"margin:0;padding:0;font-family:'Segoe UI',system-ui,sans-serif;\">\n  <div style=\"background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);border-radius:12px;padding:16px;border:1px solid rgba(255,255,255,0.1);box-shadow:0 8px 32px rgba(0,0,0,0.4);\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:10px;\">\n      <div style=\"display:flex;align-items:center;gap:12px;\">\n        <div style=\"width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:1.3em;box-shadow:0 4px 12px rgba(99,102,241,0.35);\">📅</div>\n        <div>\n          <div style=\"color:#f8fafc;font-weight:700;font-size:1.05em;letter-spacing:0.02em;\">Media Server Schedule</div>\n          <div style=\"color:#64748b;font-size:0.75em;margin-top:2px;\">Daily automatic boot &amp; graceful shutdown</div>\n        </div>\n      </div>\n      <label style=\"display:flex;align-items:center;gap:10px;cursor:pointer;background:rgba(255,255,255,0.06);padding:8px 14px;border-radius:24px;border:1px solid rgba(255,255,255,0.08);\">\n        <span :style=\"{color: enabled ? '#10b981' : '#94a3b8', fontWeight: 700, fontSize: '0.8em', letterSpacing: '0.06em'}\">{{ enabled ? 'ENABLED' : 'DISABLED' }}</span>\n        <input type=\"checkbox\" v-model=\"enabled\" @change=\"save\" style=\"accent-color:#10b981;width:18px;height:18px;cursor:pointer;\" />\n      </label>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;\">\n      <div style=\"background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.28);border-radius:10px;padding:14px;\">\n        <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px;\">\n          <span style=\"font-size:1.1em;\">⚡</span>\n          <span style=\"color:#6ee7b7;font-size:0.8em;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;\">Boot Time</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;\">\n          <input type=\"number\" min=\"0\" max=\"23\" v-model.number=\"bootH\" @change=\"save\" style=\"flex:1;min-width:0;padding:10px;border-radius:8px;border:1px solid rgba(16,185,129,0.35);background:rgba(15,23,42,0.8);color:#ecfdf5;font-family:Consolas,monospace;font-size:1.2em;font-weight:700;text-align:center;\" />\n          <span style=\"color:#64748b;font-size:1.4em;font-weight:300;\">:</span>\n          <input type=\"number\" min=\"0\" max=\"59\" v-model.number=\"bootM\" @change=\"save\" style=\"flex:1;min-width:0;padding:10px;border-radius:8px;border:1px solid rgba(16,185,129,0.35);background:rgba(15,23,42,0.8);color:#ecfdf5;font-family:Consolas,monospace;font-size:1.2em;font-weight:700;text-align:center;\" />\n        </div>\n        <div style=\"margin-top:8px;color:#64748b;font-size:0.72em;\">Tuya PCIe power button</div>\n      </div>\n      <div style=\"background:rgba(249,115,22,0.08);border:1px solid rgba(249,115,22,0.28);border-radius:10px;padding:14px;\">\n        <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px;\">\n          <span style=\"font-size:1.1em;\">🛑</span>\n          <span style=\"color:#fdba74;font-size:0.8em;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;\">Shutdown Time</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;\">\n          <input type=\"number\" min=\"0\" max=\"23\" v-model.number=\"shutH\" @change=\"save\" style=\"flex:1;min-width:0;padding:10px;border-radius:8px;border:1px solid rgba(249,115,22,0.35);background:rgba(15,23,42,0.8);color:#fff7ed;font-family:Consolas,monospace;font-size:1.2em;font-weight:700;text-align:center;\" />\n          <span style=\"color:#64748b;font-size:1.4em;font-weight:300;\">:</span>\n          <input type=\"number\" min=\"0\" max=\"59\" v-model.number=\"shutM\" @change=\"save\" style=\"flex:1;min-width:0;padding:10px;border-radius:8px;border:1px solid rgba(249,115,22,0.35);background:rgba(15,23,42,0.8);color:#fff7ed;font-family:Consolas,monospace;font-size:1.2em;font-weight:700;text-align:center;\" />\n        </div>\n        <div style=\"margin-top:8px;color:#64748b;font-size:0.72em;\">SSH graceful shutdown</div>\n      </div>\n    </div>\n    <div style=\"margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.06);display:flex;flex-wrap:wrap;gap:8px;\">\n      <span style=\"font-size:0.72em;color:#94a3b8;background:rgba(255,255,255,0.04);padding:5px 10px;border-radius:6px;\">🕐 {{ pad(bootH) }}:{{ pad(bootM) }} boot</span>\n      <span style=\"font-size:0.72em;color:#94a3b8;background:rgba(255,255,255,0.04);padding:5px 10px;border-radius:6px;\">🕐 {{ pad(shutH) }}:{{ pad(shutM) }} shutdown</span>\n    </div>\n  </div>\n</div>\n<script>\nexport default {\n  data() {\n    return { enabled: true, bootH: 8, bootM: 0, shutH: 23, shutM: 30 }\n  },\n  mounted() { this.syncFromMsg() },\n  watch: { 'msg.payload'() { this.syncFromMsg() } },\n  methods: {\n    pad(n) { return String(Number(n) || 0).padStart(2, '0') },\n    syncFromMsg() {\n      const p = this.msg && this.msg.payload ? this.msg.payload : {}\n      if (p.media_scheduler_enabled !== undefined) this.enabled = !!p.media_scheduler_enabled\n      if (p.media_sched_boot_hour !== undefined) this.bootH = Number(p.media_sched_boot_hour)\n      if (p.media_sched_boot_minute !== undefined) this.bootM = Number(p.media_sched_boot_minute)\n      if (p.media_sched_shutdown_hour !== undefined) this.shutH = Number(p.media_sched_shutdown_hour)\n      if (p.media_sched_shutdown_minute !== undefined) this.shutM = Number(p.media_sched_shutdown_minute)\n    },\n    save() {\n      this.send({\n        payload: {\n          media_scheduler_enabled: this.enabled,\n          media_sched_boot_hour: this.bootH,\n          media_sched_boot_minute: this.bootM,\n          media_sched_shutdown_hour: this.shutH,\n          media_sched_shutdown_minute: this.shutM\n        }\n      })\n    }\n  }\n}\n</script>",
        "storeOutMessages": true,
