        ]
    },
    {
        "id": "func_sms_status_metadata",
        "type": "function",
        "z": "tab_dashboard",
        "name": "SMS Status Metadata",
        "func": "let metadataKey = \"status_metadata_sms_gateway\";\nlet metadata = flow.get(metadataKey) || {\n    lastReportedMs: null,\n    lastChangedMs: null,\n    previousState: \"Unknown\",\n    currentState: \"Unknown\"\n};\n\n// Parse status - could be timestamp string, JSON, or 'offline' trigger\nlet statusData = msg.payload;\nlet newState = \"online\";\n\nif (statusData === \"offline\") {\n    newState = \"offline\";\n} else if (typeof statusData === 'string') {\n    // Try to parse as JSON\n    try {\n        statusData = JSON.parse(statusData);\n        newState = statusData.wifi === 'connected' && statusData.mqtt === 'connected' ? 'online' : 'offline';\n    } catch (e) {\n        // It's a timestamp string or other reported data, device is online\n        newState = 'online';\n    }\n} else if (typeof statusData === 'object') {\n    newState = statusData.wifi === 'connected' && statusData.mqtt === 'connected' ? 'online' : 'offline';\n}\n\nlet nowMs = Date.now();\n\n// Only update lastReported if it's an actual report, not a heartbeat timeout\nif (statusData !== \"offline\") {\n    metadata.lastReportedMs = nowMs;\n}\n\nif (newState !== metadata.currentState) {\n    metadata.previousState = metadata.currentState;\n    metadata.currentState = newState;\n    metadata.lastChangedMs = nowMs;\n}\n\nflow.set(metadataKey, metadata);\nmsg.metadata = metadata;\nmsg.payload = typeof statusData === 'object' ? statusData : { timestamp: statusData, wifi: 'connected', mqtt: 'connected', gsm: 'initialized' };\nflow.set('sms_gateway_status', msg.payload);\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 300,
        "wires": [
            [
                "template_sms_status"
            ]
        ]
    },
    {
        "id": "template_sms_status",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_sms_gateway",
        "name": "SMS Gateway Status",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div style=\"font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 12px; padding: 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); margin-top: 20px;\">\n    <!-- Status Badge -->\n    <div style=\"display: flex; align-items: center; justify-content: center; margin-bottom: 20px;\">\n        <div :style=\"statusBadgeStyle\" style=\"padding: 12px 32px; border-radius: 24px; display: flex; align-items: center; gap: 12px; transition: all 0.3s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.3);\">\n            <div :style=\"statusDotStyle\" style=\"width: 12px; height: 12px; border-radius: 50%; animation: pulse 2s ease-in-out infinite;\"></div>\n            <span style=\"font-weight: 700; font-size: 1.3em; letter-spacing: 0.5px; text-transform: uppercase;\">\n                {{msg.payload.wifi === 'connected' && msg.payload.mqtt === 'connected' ? 'ONLINE' : 'OFFLINE'}}\n            </span>\n        </div>\n    </div>\n    \n    <!-- Connection Status -->\n    <div style=\"display: grid; gap: 8px;\">\n        <div style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 10px; display: flex; justify-content: space-between; align-items: center;\">\n            <span style=\"color: #94a3b8; font-size: 0.9em;\">📶 WiFi</span>\n            <span :style=\"{ color: msg.payload.wifi === 'connected' ? '#10b981' : '#ef4444' }\">{{msg.payload.wifi || 'unknown'}}</span>\n        </div>\n        <div style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 10px; display: flex; justify-content: space-between; align-items: center;\">\n            <span style=\"color: #94a3b8; font-size: 0.9em;\">📡 MQTT</span>\n            <span :style=\"{ color: msg.payload.mqtt === 'connected' ? '#10b981' : '#ef4444' }\">{{msg.payload.mqtt || 'unknown'}}</span>\n        </div>\n        <div style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 10px; display: flex; justify-content: space-between; align-items: center;\">\n            <span style=\"color: #94a3b8; font-size: 0.9em;\">📱 GSM</span>\n            <span :style=\"{ color: msg.payload.gsm === 'initialized' ? '#10b981' : '#ef4444' }\">{{msg.payload.gsm || 'unknown'}}</span>\n        </div>\n        <div style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 10px; display: flex; justify-content: space-between; align-items: center;\">\n            <span style=\"color: #94a3b8; font-size: 0.9em;\">⏱️ Last Update</span>\n            <span style=\"color: #e2e8f0; font-family: 'Consolas', monospace; font-size: 0.85em;\">{{formatDelta(msg.metadata.lastReportedMs)}}</span>\n        </div>\n    </div>\n</div>\n\n<style>\n@keyframes pulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.5; transform: scale(1.1); }\n}\n</style>\n\n<script>\nexport default {\n    data() {\n        return {\n            now: Date.now(),\n            timer: null\n        }\n    },\n    mounted() {\n        this.timer = setInterval(() => {\n            this.now = Date.now()\n        }, 1000)\n    },\n    unmounted() {\n        clearInterval(this.timer)\n    },\n    methods: {\n        formatDelta(ms) {\n            if (!ms) return 'Never'\n            const seconds = Math.floor((this.now - ms) / 1000)\n            if (seconds < 2) return 'Just now'\n            if (seconds < 60) return `${seconds}s ago`\n            if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`\n            if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`\n            return new Date(ms).toLocaleDateString()\n        }\n    },\n    computed: {\n        statusBadgeStyle() {\n            const wifi = this.msg.payload.wifi === 'connected';\n            const mqtt = this.msg.payload.mqtt === 'connected';\n            if (wifi && mqtt) {\n                return {\n                    background: 'linear-gradient(135deg, #10b981 0%, #059669 100%)',\n                    color: '#ffffff',\n                    boxShadow: '0 4px 20px rgba(16, 185, 129, 0.4)'\n                }\n            } else {\n                return {\n                    background: 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)',\n                    color: '#ffffff',\n                    boxShadow: '0 4px 20px rgba(239, 68, 68, 0.4)'\n                }\n            }\n        },\n        statusDotStyle() {\n            const wifi = this.msg.payload.wifi === 'connected';\n            const mqtt = this.msg.payload.mqtt === 'connected';\n            return {\n                background: wifi && mqtt ? '#ffffff' : '#ffffff',\n                boxShadow: `0 0 8px ${wifi && mqtt ? '#10b981' : '#ef4444'}`\n            }\n        }\n    }\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 640,
        "y": 300,
        "wires": [
            []
        ]
