        "name": "Dell Status UI",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div style=\"display: flex; flex-direction: column; gap: 6px; padding: 10px; background: rgba(30, 30, 30, 0.7); backdrop-filter: blur(8px); border-radius: 10px; border: 1px solid #444; color: #eee; box-shadow: 0 4px 15px rgba(0,0,0,0.3);\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;\">\n        <span style=\"font-size: 0.8em; color: #888; text-transform: uppercase; letter-spacing: 0.1em; font-weight: bold;\">Server State</span>\n        <span :style=\"{\n            color: msg.payload.server_state === 'online' ? '#4caf50' : (msg.payload.server_state === 'offline' ? '#f44336' : '#ff9800'),\n            fontWeight: '900',\n            fontSize: '1.4em',\n            textShadow: '0 0 12px ' + (msg.payload.server_state === 'online' ? 'rgba(76, 175, 80, 0.5)' : 'rgba(244, 67, 54, 0.5)')\n        }\">\n            {{msg.payload.server_state ? msg.payload.server_state.toUpperCase() : 'UNKNOWN'}}\n        </span>\n    </div>\n    <div style=\"height: 1px; background: linear-gradient(to right, #555, transparent); margin-bottom: 8px;\"></div>\n    <div style=\"font-size: 0.85em; line-height: 1.6; display: grid; grid-template-columns: auto 1fr; gap: 0 10px;\">\n        <span style=\"color: #777;\">Last Report:</span>\n        <span style=\"color: #ccc; text-align: right; font-family: monospace;\">{{msg.metadata.lastReported}}</span>\n        \n        <span style=\"color: #777;\">Switched:</span>\n        <span style=\"color: #ccc; text-align: right; font-family: monospace;\">{{msg.metadata.lastChanged}}</span>\n        \n        <span v-if=\"msg.metadata.previousState !== 'Unknown'\" style=\"color: #777;\">Previous:</span>\n        <span v-if=\"msg.metadata.previousState !== 'Unknown'\" style=\"color: #999; text-align: right; font-style: italic;\">{{msg.metadata.previousState}}</span>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 600,
        "y": 300,
        "wires": [
