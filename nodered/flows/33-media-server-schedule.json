        "id": "media_sched_ui_save_fn",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Save schedule to flow",
        "func": "const p = msg.payload || {};\nif (p.media_scheduler_enabled !== undefined) flow.set('media_scheduler_enabled', !!p.media_scheduler_enabled);\nif (p.media_sched_boot_hour !== undefined) flow.set('media_sched_boot_hour', Number(p.media_sched_boot_hour));\nif (p.media_sched_boot_minute !== undefined) flow.set('media_sched_boot_minute', Number(p.media_sched_boot_minute));\nif (p.media_sched_shutdown_hour !== undefined) flow.set('media_sched_shutdown_hour', Number(p.media_sched_shutdown_hour));\nif (p.media_sched_shutdown_minute !== undefined) flow.set('media_sched_shutdown_minute', Number(p.media_sched_shutdown_minute));\nnode.status({ fill: 'green', shape: 'dot', text: 'Schedule saved' });\nreturn null;",
