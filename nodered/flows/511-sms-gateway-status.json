    {
        "id": "func_store_sms_timestamp",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Process Complete SMS",
        "func": "// All three parts received, combine into complete SMS message\nconst from = flow.get('sms_current_from') || 'Unknown';\nconst text = flow.get('sms_current_text') || '';\nconst timestamp = msg.payload || new Date().toISOString();\n\n// Create complete SMS message object\nconst smsMessage = {\n    from: from,\n    text: text,\n    timestamp: timestamp,\n    receivedAt: new Date().toISOString()\n};\n\n// Get message log from flow context\nlet messageLog = flow.get('sms_message_log') || [];\n\n// Add to log (keep last 100 messages)\nmessageLog.unshift(smsMessage);\nif (messageLog.length > 100) {\n    messageLog = messageLog.slice(0, 100);\n}\n\n// Store updated log\nflow.set('sms_message_log', messageLog);\n\n// Clear temporary storage\nflow.set('sms_current_from', null);\nflow.set('sms_current_text', null);\n\n// Prepare message for UI\nmsg.payload = {\n    messages: messageLog,\n    messageCount: messageLog.length,\n    latest: smsMessage\n};\n\nnode.status({fill: \"green\", shape: \"dot\", text: `${messageLog.length} messages`});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [
            [
                "template_sms_log"
            ]
        ]
    },
    {
        "id": "template_sms_log",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_sms_logs",
        "name": "SMS Messages Log",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<div style=\"font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 12px; padding: 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1); max-height: 600px; overflow-y: auto;\">\n    <div style=\"margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center;\">\n        <h3 style=\"margin: 0; color: #e2e8f0; font-size: 1.2em;\">📱 Received Messages ({{msg.payload.messageCount || 0}})</h3>\n        <button @click=\"clearLog\" style=\"background: #ef4444; color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 0.85em;\">Clear</button>\n    </div>\n    \n    <div v-if=\"msg.payload.messageCount === 0\" style=\"text-align: center; padding: 40px; color: #94a3b8;\">\n        <div style=\"font-size: 3em; margin-bottom: 10px;\">📭</div>\n        <div>No messages received yet</div>\n    </div>\n    \n    <div v-else style=\"display: flex; flex-direction: column; gap: 12px;\">\n        <div v-for=\"(msg, index) in msg.payload.messages\" :key=\"index\" style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 15px; border-left: 3px solid #3b82f6; transition: all 0.2s ease;\" :style=\"{ borderLeftColor: index === 0 ? '#10b981' : '#3b82f6' }\">\n            <div style=\"display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;\">\n                <div style=\"display: flex; align-items: center; gap: 8px;\">\n                    <span style=\"font-size: 1.2em;\">📨</span>\n                    <span style=\"color: #e2e8f0; font-weight: 600; font-size: 0.95em;\">{{msg.from}}</span>\n                    <span v-if=\"index === 0\" style=\"background: #10b981; color: white; padding: 2px 8px; border-radius: 10px; font-size: 0.7em; font-weight: 600;\">NEW</span>\n                </div>\n                <span style=\"color: #94a3b8; font-size: 0.8em; font-family: 'Consolas', monospace;\">{{formatTime(msg.timestamp)}}</span>\n            </div>\n            <div style=\"color: #cbd5e1; font-size: 0.9em; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word;\">{{msg.text}}</div>\n        </div>\n    </div>\n</div>\n\n<script>\nexport default {\n    methods: {\n        formatTime(timestamp) {\n            if (!timestamp) return 'Unknown';\n            try {\n                const date = new Date(timestamp);\n                const now = new Date();\n                const diffMs = now - date;\n                const diffSec = Math.floor(diffMs / 1000);\n                \n                if (diffSec < 60) return `${diffSec}s ago`;\n                if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;\n                if (diffSec < 86400) return `${Math.floor(diffSec / 3600)}h ago`;\n                return date.toLocaleString();\n            } catch (e) {\n                return timestamp;\n            }\n        },\n        clearLog() {\n            // Clear log via flow context\n            this.$send({ payload: { action: 'clear' } });\n        }\n    }\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 640,
        "y": 180,
        "wires": [
            []
        ]
    },
    {
        "id": "inject_clear_log",
        "type": "inject",
        "z": "tab_dashboard",
        "name": "Clear Log",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"action\": \"clear\"}",
        "payloadType": "json",
        "x": 160,
        "y": 240,
        "wires": [
            [
                "func_clear_sms_log"
            ]
        ]
    },
    {
        "id": "func_clear_sms_log",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Clear SMS Log",
        "func": "// Clear message log\nflow.set('sms_message_log', []);\n\n// Update UI\nmsg.payload = {\n    messages: [],\n    messageCount: 0,\n    latest: null\n};\n\nnode.status({fill: \"blue\", shape: \"dot\", text: \"Log cleared\"});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 240,
        "wires": [
            [
                "template_sms_log"
            ]
        ]
    }
]
