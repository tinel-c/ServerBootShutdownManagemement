in-top:8px; font-size:0.62em; color:#64748b; line-height:1.45; word-break:break-word; }\n.ec-meta strong { color:#94a3b8; font-weight:600; }\n.ec-actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; }\n.ec-btn { appearance:none; -webkit-appearance:none; min-height:40px; padding:8px 10px; border:none; border-radius:8px; font-size:clamp(0.78em,2vw,0.85em); font-weight:700; cursor:pointer; width:100%; line-height:1.2; touch-action:manipulation; }\n.ec-btn:disabled { opacity:0.45; cursor:not-allowed; }\n@media (max-width:520px) { .ec-metrics { grid-template-columns:repeat(2,minmax(0,1fr)); } .ec-actions { grid-template-columns:1fr; } }\n</style>\n<div class=\"ec-card\">\n  <div class=\"ec-inner\">\n    <div class=\"ec-head\">\n      <div style=\"min-width:0;flex:1;\">\n        <div class=\"ec-title\">{{ displayName }}</div>\n        <div class=\"ec-id\">garden-power-hut · Tasmota</div>\n      </div>\n      <div class=\"ec-head-badges\">\n        <div class=\"ec-pill\" :style=\"onlinePillStyle\">{{ onlineLabel }}</div>\n        <div class=\"ec-updated\">Updated <span class=\"ec-updated-val\" :style=\"dataAgeStyle\">{{ updateElapsed }}</span> ago</div>\n      </div>\n    </div>\n    <div class=\"ec-section\">\n      <div class=\"ec-section-label\">Live</div>\n      <div class=\"ec-metrics\">\n        <div class=\"ec-metric power\"><div class=\"ec-label\">W</div><div class=\"ec-value\">{{ formatW(powerW) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">V</div><div class=\"ec-value\">{{ formatV(voltageV) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">A</div><div class=\"ec-value\">{{ formatA(currentA) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">PF</div><div class=\"ec-value\">{{ formatPf(powerFactor) }}</div></div>\n      </div>\n    </div>\n    <div class=\"ec-section\">\n      <div class=\"ec-section-label\">Energy</div>\n      <div class=\"ec-metrics\">\n        <div class=\"ec-metric\"><div class=\"ec-label\">Total kWh</div><div class=\"ec-value\">{{ formatKwh(energyKwh) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">Today</div><div class=\"ec-value\">{{ formatKwh(energyToday) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">Yesterday</div><div class=\"ec-value\">{{ formatKwh(energyYesterday) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">Period Wh</div><div class=\"ec-value\">{{ formatWh(energyPeriod) }}</div></div>\n      </div>\n    </div>\n    <div class=\"ec-section\">\n      <div class=\"ec-section-label\">Power quality</div>\n      <div class=\"ec-metrics\">\n        <div class=\"ec-metric\"><div class=\"ec-label\">Apparent W</div><div class=\"ec-value\">{{ formatW(apparentPower) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">Reactive W</div><div class=\"ec-value\">{{ formatW(reactivePower) }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">Relay</div><div class=\"ec-value\" :style=\"{ color: switchOn ? '#34d399' : '#94a3b8' }\">{{ relayLabel }}</div></div>\n        <div class=\"ec-metric\"><div class=\"ec-label\">Source</div><div class=\"ec-value\" style=\"font-size:0.65em;\">{{ phaseSource }}</div></div>\n      </div>\n    </div>\n    <div class=\"ec-meta\">\n      <div v-if=\"tasmotaTime\"><strong>Device time</strong> {{ tasmotaTime }}</div>\n      <div v-if=\"totalStartTime\"><strong>Meter since</strong> {{ totalStartTime }}</div>\n      <div v-if=\"tasmotaTopic\"><strong>MQTT topic</strong> {{ tasmotaTopic }}</div>\n    </div>\n    <div class=\"ec-actions\">\n        <button type=\"button\" class=\"ec-btn\" :style=\"onBtnStyle\" :disabled=\"!canControl\" @click.prevent=\"sendSwitch('on')\">ON</button>\n        <button type=\"button\" class=\"ec-btn\" :style=\"offBtnStyle\" :disabled=\"!canControl\" @click.prevent=\"sendSwitch('off')\">OFF</button>\n      </div>\n  </div>\n</div>\n<script>\nexport default {\n  data() { return { now: Date.now(), timer: null, staleAfterS: 660 }; },\n  mounted() { this.timer = setInterval(() => { this.now = Date.now(); }, 1000); },\n  unmounted() { clearInterval(this.timer); },\n  methods: {\n    formatW(v) { if (v == null || v === '') return '—'; const n = Number(v); return Number.isNaN(n) ? '—' : Math.round(n); },\n    formatKwh(v) { if (v == null || v === '') return '—'; const n = Number(v); return Number.isNaN(n) ? '—' : n.toFixed(3); },\n    formatV(v) { if (v == null || v === '') return '—'; const n = Number(v); return Number.isNaN(n) ? '—' : n.toFixed(1); },\n    formatA(v) { if (v == null || v === '') return '—'; const n = Number(v); return Number.isNaN(n) ? '—' : n.toFixed(2); },\n    formatPf(v) { if (v == null || v === '') return '—'; const n = Number(v); return Number.isNaN(n) ? '—' : n.toFixed(2); },\n    formatWh(v) { if (v == null || v === '') return '—'; const n = Number(v); return Number.isNaN(n) ? '—' : Math.round(n); },\n    parseMs(v) {\n      if (v == null || v === '') return null;\n      if (typeof v === 'number' && !Number.isNaN(v)) return v;\n      try { const ms = new Date(v).getTime(); return Number.isNaN(ms) ? null : ms; } catch (e) { return null; }\n    },\n    pad2(n) { return String(n).padStart(2, '0'); },\n    sendSwitch(action) {\n      if (!this.canControl) return;\n      this.send({ payload: { consumer_id: 'garden-power-hut', action, source: 'nodered', timestamp: new Date().toISOString() } });\n    }\n  },\n  computed: {\n    p() { return this.msg.payload || {}; },\n    ex() { return this.p.extra || {}; },\n    displayName() { return this.p.name || 'Garden Power Hut'; },\n    powerW() { return this.p.power_w; },\n    energyKwh() { return this.p.energy_kwh; },\n    voltageV() { return this.p.voltage_v; },\n    currentA() { return this.p.current_a; },\n    energyToday() { return this.ex.energy_today; },\n    energyYesterday() { return this.ex.energy_yesterday; },\n    energyPeriod() { return this.ex.energy_period; },\n    apparentPower() { return this.ex.energy_apparentpower; },\n    reactivePower() { return this.ex.energy_reactivepower; },\n    powerFactor() { return this.ex.energy_factor; },\n    totalStartTime() { return this.ex.energy_totalstarttime || ''; },\n    tasmotaTime() { return this.ex.tasmota_time || ''; },\n    tasmotaTopic() { return this.ex.tasmota_topic || ''; },\n    phaseSource() { return this.ex.phase_source || this.p.source || '—'; },\n    switchOn() {\n      if (this.ex.switch_on !== undefined) return !!this.ex.switch_on;\n      return null;\n    },\n    relayLabel() {\n      if (this.switchOn === null) return '—';\n      return this.switchOn ? 'ON' : 'OFF';\n    },\n    canControl() { return this.p.online !== false; },\n    onlineLabel() { return this.p.online === false ? 'Offline' : 'Online'; },\n    onlinePillStyle() {\n      const on = this.p.online !== false;\n      return { background: on ? '#059669' : '#dc2626', color: '#fff' };\n    },\n    onBtnStyle() {\n      const lit = this.switchOn === true;\n      return { background: lit ? '#047857' : '#059669', color: '#fff', boxShadow: lit ? '0 0 0 2px #34d399' : 'none' };\n    },\n    offBtnStyle() {\n      const lit = this.switchOn === false;\n      return { background: lit ? '#334155' : '#475569', color: '#f8fafc', boxShadow: lit ? '0 0 0 2px #94a3b8' : 'none' };\n    },\n    lastFetchedMs() {\n      const received = this.msg.metadata?.receivedAtMs;\n      if (received) return received;\n      const meta = this.msg.metadata?.lastReportedMs;\n      if (meta) return meta;\n      if (this.p._fetched_at_ms) return this.p._fetched_at_ms;\n      return this.parseMs(this.p.timestamp);\n    },\n    updateElapsed() {\n      const ms = this.lastFetchedMs;\n      if (!ms) return '—:—';\n      void this.now;\n      const sec = Math.max(0, Math.floor((this.now - ms) / 1000));\n      const m = Math.floor(sec / 60);\n      const s = sec % 60;\n      return this.pad2(m) + ':' + this.pad2(s);\n    },\n    dataAgeStyle() {\n      const ms = this.lastFetchedMs;\n      if (!ms) return { color: '#e2e8f0' };\n      void this.now;\n      const s = (this.now - ms) / 1000;\n      if (s > this.staleAfterS) return { color: '#fbbf24' };\n      return { color: '#e2e8f0' };\n    }\n  }\n};\n</script>",
