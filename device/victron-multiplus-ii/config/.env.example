# Victron MultiPlus-II — local configuration template
# Copy to config/.env and adjust for your installation (config/.env is gitignored).

# GX device (Cerbo GX, Venus GX, or MultiPlus-II GX) on your LAN
VICTRON_GX_HOST=192.168.x.x
VICTRON_GX_MODBUS_PORT=502

# Modbus Unit ID for com.victronenergy.vebus (MultiPlus-II)
# Verify: GX menu → Settings → Services → Modbus TCP → Available services
# Cerbo VE.Bus ≈ 227 | MultiPlus-II GX internal ≈ 228 | CCGX VE.Bus ≈ 246
VICTRON_VEBUS_UNIT_ID=227

# Modbus Unit ID for system-wide data (battery, grid, consumption)
VICTRON_SYSTEM_UNIT_ID=100

# Solar charger (MPPT) — leave empty to auto-scan Cerbo VE.Direct ports
# VICTRON_SOLARCHARGER_UNIT_ID=226

# Grid-tie PV inverter / energy meter (com.victronenergy.pvinverter) — check Available services
# VICTRON_PVINVERTER_UNIT_ID=

# VRM Portal ID — required for MQTT topic paths
# GX menu → Settings → VRM online portal → VRM Portal ID
VICTRON_PORTAL_ID=your_portal_id_here

# MQTT on GX (local FlashMQ broker)
VICTRON_MQTT_HOST=192.168.x.x
VICTRON_MQTT_PORT=1883
# VICTRON_MQTT_USERNAME=
# VICTRON_MQTT_PASSWORD=

# Optional: bridge target (this repo's automation MQTT broker)
MQTT_BROKER_HOST=192.168.2.4
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Publisher settings
VICTRON_MQTT_PREFIX=energy/victron
VICTRON_MODBUS_POLL_INTERVAL=10
VICTRON_MQTT_QOS=1

# Polling interval for Modbus-based scripts (seconds) — alias for publisher
