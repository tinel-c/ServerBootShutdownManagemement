CAMERA_5_MQTT_PREFIX="garden/camera/fataCasa"

# Curte strada — was 192.168.2.35 (offline); rediscovered @ .59 (enable ONVIF in Tapo app)
CAMERA_6_NAME="Curte strada"
CAMERA_6_IP=192.168.2.59
CAMERA_6_PORT=2020
CAMERA_6_USER=your_camera_account
CAMERA_6_PASS=your_camera_password
CAMERA_6_MQTT_PREFIX="garden/camera/strada"

# Same physical device as Poarta glisanta 2 @ .34 (tapo-monitor merges by IP)
CAMERA_7_NAME="Poarta glisanta 1"
