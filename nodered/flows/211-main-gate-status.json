    {
        "id": "gate_status_timestamp",
        "type": "function",
        "z": "gate_main_tab",
        "name": "Format Timestamp",
        "func": "// Add formatted timestamp\nconst now = new Date();\nmsg.myrawdate = now.toLocaleString('ro-RO', {\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit'\n});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 700,
        "wires": [
