    {
        "id": "gate_status_update_context",
        "type": "function",
        "z": "gate_main_tab",
        "name": "Update Context",
        "func": "// Update gate state in context\nlet state = flow.get('gate_state') || {};\nif (!state.mainGate) state.mainGate = {};\n\nstate.mainGate.power = msg.payload;\nstate.mainGate.lastUpdate = new Date().toISOString();\n\nflow.set('gate_state', state);\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 1240,
        "wires": [
