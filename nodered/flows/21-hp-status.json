[
    {
        "id": "mqtt_in_hp_status",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "HP DL360p Status",
        "topic": "hp/dl360p/status",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 170,
        "y": 600,
        "wires": [
            [
                "func_hp_status_metadata"
            ]
        ]
    },
    {
        "id": "func_hp_status_metadata",
        "type": "function",
        "z": "tab_dashboard",
        "name": "HP Status Metadata",
        "func": "let metadataKey = \"status_metadata_\" + msg.topic.replace(/\\//g, \"_\");\nlet metadata = flow.get(metadataKey) || {\n    lastReportedMs: null,\n    lastChangedMs: null,\n    previousState: \"Unknown\",\n    currentState: \"Unknown\"\n};\n\nlet newState = msg.payload.server_state;\nlet nowMs = msg.payload.timestamp ? new Date(msg.payload.timestamp).getTime() : Date.now();\n\nmetadata.lastReportedMs = nowMs;\n\nif (newState !== metadata.currentState) {\n    metadata.previousState = metadata.currentState;\n    metadata.currentState = newState;\n    metadata.lastChangedMs = nowMs;\n}\n\nflow.set(metadataKey, metadata);\nmsg.metadata = metadata;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 600,
        "wires": [
            [
                "template_hp_status"
            ]
        ]
    },
    {
        "id": "template_hp_status",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_hp",
        "name": "HP Status UI",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div style=\"font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border-radius: 12px; padding: 20px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1);\">\n    <!-- Status Badge -->\n    <div style=\"display: flex; align-items: center; justify-content: center; margin-bottom: 20px;\">\n        <div :style=\"statusBadgeStyle\" style=\"padding: 12px 32px; border-radius: 24px; display: flex; align-items: center; gap: 12px; transition: all 0.3s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.3);\">\n            <div :style=\"statusDotStyle\" style=\"width: 12px; height: 12px; border-radius: 50%; animation: pulse 2s ease-in-out infinite;\"></div>\n            <span style=\"font-weight: 700; font-size: 1.3em; letter-spacing: 0.5px; text-transform: uppercase;\">\n                {{msg.payload.server_state || 'UNKNOWN'}}\n            </span>\n        </div>\n    </div>\n    \n    <!-- Info Grid -->\n    <div style=\"display: grid; gap: 12px;\">\n        <!-- Last Report Card -->\n        <div style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; border-left: 3px solid #3b82f6; transition: all 0.2s ease;\" onmouseover=\"this.style.background='rgba(255,255,255,0.08)'\" onmouseout=\"this.style.background='rgba(255,255,255,0.05)'\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                <div style=\"display: flex; align-items: center; gap: 8px;\">\n                    <span style=\"font-size: 1.2em;\">📡</span>\n                    <span style=\"color: #94a3b8; font-size: 0.9em; font-weight: 500;\">Last Report</span>\n                </div>\n                <span style=\"color: #e2e8f0; font-family: 'Consolas', monospace; font-weight: 600; font-size: 0.95em;\">\n                    {{formatDelta(msg.metadata.lastReportedMs)}}\n                </span>\n            </div>\n        </div>\n        \n        <!-- State Changed Card -->\n        <div style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; border-left: 3px solid #8b5cf6; transition: all 0.2s ease;\" onmouseover=\"this.style.background='rgba(255,255,255,0.08)'\" onmouseout=\"this.style.background='rgba(255,255,255,0.05)'\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                <div style=\"display: flex; align-items: center; gap: 8px;\">\n                    <span style=\"font-size: 1.2em;\">⏱️</span>\n                    <span style=\"color: #94a3b8; font-size: 0.9em; font-weight: 500;\">State Changed</span>\n                </div>\n                <span style=\"color: #e2e8f0; font-family: 'Consolas', monospace; font-weight: 600; font-size: 0.95em;\">\n                    {{formatDelta(msg.metadata.lastChangedMs)}}\n                </span>\n            </div>\n        </div>\n        \n        <!-- Previous State Card -->\n        <div v-if=\"msg.metadata.previousState !== 'Unknown'\" style=\"background: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; border-left: 3px solid #64748b; transition: all 0.2s ease;\" onmouseover=\"this.style.background='rgba(255,255,255,0.08)'\" onmouseout=\"this.style.background='rgba(255,255,255,0.05)'\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                <div style=\"display: flex; align-items: center; gap: 8px;\">\n                    <span style=\"font-size: 1.2em;\">🔄</span>\n                    <span style=\"color: #94a3b8; font-size: 0.9em; font-weight: 500;\">Previous State</span>\n                </div>\n                <span style=\"color: #cbd5e1; font-style: italic; font-size: 0.95em; text-transform: capitalize;\">\n                    {{msg.metadata.previousState}}\n                </span>\n            </div>\n        </div>\n    </div>\n</div>\n\n<style>\n@keyframes pulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.5; transform: scale(1.1); }\n}\n</style>\n\n<script>\nexport default {\n    data() {\n        return {\n            now: Date.now(),\n            timer: null\n        }\n    },\n    mounted() {\n        this.timer = setInterval(() => {\n            this.now = Date.now()\n        }, 1000)\n    },\n    unmounted() {\n        clearInterval(this.timer)\n    },\n    methods: {\n        formatDelta(ms) {\n            if (!ms) return 'Never'\n            const seconds = Math.floor((this.now - ms) / 1000)\n            if (seconds < 2) return 'Just now'\n            if (seconds < 60) return `${seconds}s ago`\n            if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`\n            if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`\n            return new Date(ms).toLocaleDateString()\n        }\n    },\n    computed: {\n        statusBadgeStyle() {\n            const state = (this.msg.payload.server_state || 'unknown').toLowerCase()\n            if (state === 'online' || state === 'up') {\n                return {\n                    background: 'linear-gradient(135deg, #10b981 0%, #059669 100%)',\n                    color: '#ffffff',\n                    boxShadow: '0 4px 20px rgba(16, 185, 129, 0.4)'\n                }\n            } else if (state === 'offline' || state === 'down') {\n                return {\n                    background: 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)',\n                    color: '#ffffff',\n                    boxShadow: '0 4px 20px rgba(239, 68, 68, 0.4)'\n                }\n            } else {\n                return {\n                    background: 'linear-gradient(135deg, #f59e0b 0%, #d97706 100%)',\n                    color: '#ffffff',\n                    boxShadow: '0 4px 20px rgba(245, 158, 11, 0.4)'\n                }\n            }\n        },\n        statusDotStyle() {\n            const state = (this.msg.payload.server_state || 'unknown').toLowerCase()\n            const color = '#ffffff'\n            return {\n                background: color,\n                boxShadow: `0 0 8px ${color}`\n            }\n        }\n    }\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 600,
        "y": 600,
        "wires": [
            []
        ]
    }
]

