# Grundfos SCALA1 — BLE to MQTT publisher
# Copy to config/.env and adjust (config/.env is gitignored).

# BLE target (required for publisher)
# Run: python3 device/grundfos-scala1/scripts/ble_probe.py --scan
SCALA1_BLE_ADDRESS=AA:BB:CC:DD:EE:FF
# Optional: hci0, hci1, … (Linux adapter name)
# SCALA1_BLE_ADAPTER=hci0
SCALA1_BLE_NAME_FILTER=SCALA
SCALA1_BLE_SCAN_TIMEOUT=10
SCALA1_BLE_CONNECT_TIMEOUT=20

# Device metadata (shown in MQTT / dashboard)
SCALA1_DEVICE_NAME=scala1-booster
SCALA1_DEVICE_MODEL=SCALA1 3-35
SCALA1_DEVICE_SERIAL=

# GATT UUIDs — fill after ble_probe.py --dump (see docs/BLE_PROTOCOL.md)
# SCALA1_TELEMETRY_SERVICE_UUID=
# SCALA1_TELEMETRY_CHAR_UUID=
# SCALA1_CONTROL_SERVICE_UUID=
# SCALA1_CONTROL_WRITE_CHAR_UUID=
# SCALA1_CONTROL_START_HEX=
# SCALA1_CONTROL_STOP_HEX=
# SCALA1_CONTROL_RESET_ALARM_HEX=

# Advanced field decoding (optional)
# SCALA1_METRICS_MAP=/opt/dell_server_management/device/grundfos-scala1/config/metrics_map.yaml

# MQTT (inherits repo config/.env if unset)
MQTT_BROKER_HOST=192.168.2.4
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

SCALA1_MQTT_PREFIX=water/grundfos/scala1
SCALA1_POLL_INTERVAL=15
SCALA1_MQTT_QOS=1
