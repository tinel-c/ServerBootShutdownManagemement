    {
        "id": "media_sched_daily_fn",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Daily media server scheduler",
        "func": "if (flow.get('media_sched_boot_hour') == null) flow.set('media_sched_boot_hour', 8);\nif (flow.get('media_sched_boot_minute') == null) flow.set('media_sched_boot_minute', 0);\nif (flow.get('media_sched_shutdown_hour') == null) flow.set('media_sched_shutdown_hour', 23);\nif (flow.get('media_sched_shutdown_minute') == null) flow.set('media_sched_shutdown_minute', 30);\n\nconst enabled = flow.get('media_scheduler_enabled') !== false;\nif (!enabled) {\n    node.status({ fill: 'grey', shape: 'ring', text: 'Scheduler off' });\n    return [null, null];\n}\n\nconst now = new Date();\nconst h = now.getHours();\nconst mi = now.getMinutes();\nconst ymd = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');\n\nconst bootH = Number(flow.get('media_sched_boot_hour'));\nconst bootM = Number(flow.get('media_sched_boot_minute'));\nconst shutH = Number(flow.get('media_sched_shutdown_hour'));\nconst shutM = Number(flow.get('media_sched_shutdown_minute'));\n\nif (h === bootH && mi === bootM) {\n    const key = 'media_sched_fired_boot_' + ymd;\n    if (flow.get(key)) return [null, null];\n    flow.set(key, true);\n    node.status({ fill: 'green', shape: 'dot', text: 'Boot scheduled' });\n    return [{\n        topic: 'media/server/command/boot',\n        payload: { action: 'boot', method: 'tuya_power', timestamp: new Date().toISOString(), request_id: 'sched-boot-' + Date.now() }\n    }, null];\n}\n\nif (h === shutH && mi === shutM) {\n    const key = 'media_sched_fired_shutdown_' + ymd;\n    if (flow.get(key)) return [null, null];\n    flow.set(key, true);\n    node.status({ fill: 'orange', shape: 'dot', text: 'Shutdown scheduled' });\n    return [null, {\n        topic: 'media/server/command/shutdown',\n        payload: { action: 'shutdown', type: 'graceful', timestamp: new Date().toISOString(), request_id: 'sched-shutdown-' + Date.now() }\n    }];\n}\n\nreturn [null, null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 1160,
        "wires": [
            [
                "media_sched_mqtt_boot"
            ],
            [
                "media_sched_mqtt_shutdown"
            ]
        ]
    },
