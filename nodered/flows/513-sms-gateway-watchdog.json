[
    {
        "id": "sms_watchdog_comment",
        "type": "comment",
        "z": "tab_dashboard",
        "name": "═══════════════ SMS GATEWAY WATCHDOG ═══════════════",
        "info": "## SMS Gateway Watchdog Management\n\n**Flow Number:** 513\n**Domain:** SMS/Notifications (500-599)\n\n### Purpose\nMonitors and manages devices watched by the SMS Gateway.\n\n### Features\n- Real-time status list of watched devices\n- Enroll/Update monitored devices\n- Delete monitored devices\n- Manual heartbeat pulse for any device\n- Dedicated Test Device controls",
        "x": 280,
        "y": 40,
        "wires": []
    },
    {
        "id": "mqtt_in_watchdog_status",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Watchdog Status",
        "topic": "sms/gateway/watchdog/status",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 100,
        "wires": [
            [
                "template_watchdog_list"
            ]
        ]
    },
    {
        "id": "template_watchdog_list",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_sms_watchdog",
        "name": "Watchdog List",
        "order": 6,
        "width": 6,
        "height": 12,
        "format": "<div class=\"sx-card\">\r\n    <div class=\"sx-head\">\r\n        <div>\r\n            <div class=\"sx-kicker\">Watchdog</div>\r\n            <h3 class=\"sx-title\">Monitored devices</h3>\r\n        </div>\r\n        <div class=\"sx-count\">{{ (msg.payload && msg.payload.length) || 0 }} active</div>\r\n    </div>\r\n\r\n    <div class=\"sx-scroll\">\r\n        <div v-if=\"!msg.payload || msg.payload.length === 0\" class=\"sx-empty\">No devices enrolled</div>\r\n        <div v-for=\"dev in msg.payload\" :key=\"dev.name\" class=\"sx-dev\" :class=\"{ 'is-on': dev.online }\">\r\n            <div>\r\n                <div class=\"sx-dev-name\">\r\n                    <span class=\"sx-live\"></span>\r\n                    <span>{{ dev.name }}</span>\r\n                </div>\r\n                <div class=\"sx-meta\">\r\n                    <span>Every {{ dev.interval }}s</span>\r\n                    <span>Last pulse {{ dev.age }}s ago</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"sx-actions\">\r\n                <button type=\"button\" class=\"sx-btn sx-btn-pulse\" @click=\"pulseDevice(dev.name)\">Pulse</button>\r\n                <button type=\"button\" class=\"sx-btn sx-btn-danger\" @click=\"deleteDevice(dev.name)\">Remove</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"sx-form\">\r\n        <div class=\"sx-note\">Enroll a device</div>\r\n        <div class=\"sx-enroll\">\r\n            <input class=\"sx-input\" v-model=\"newName\" placeholder=\"Device name\" aria-label=\"Device name\" @keyup.enter=\"enrollDevice\">\r\n            <input class=\"sx-input\" v-model.number=\"newInterval\" type=\"number\" min=\"1\" placeholder=\"Seconds\" aria-label=\"Sync interval in seconds\">\r\n            <button type=\"button\" class=\"sx-btn sx-btn-primary sx-add\" @click=\"enrollDevice\">Add</button>\r\n        </div>\r\n        <div class=\"sx-note\">Test device</div>\r\n        <div class=\"sx-tests\">\r\n            <button type=\"button\" class=\"sx-btn\" @click=\"enrollTest\">Enroll test</button>\r\n            <button type=\"button\" class=\"sx-btn\" @click=\"deleteDevice('test-device')\">Remove test</button>\r\n            <button type=\"button\" class=\"sx-btn sx-btn-pulse\" @click=\"pulseDevice('test-device')\">Test pulse</button>\r\n            <button type=\"button\" class=\"sx-btn\" :class=\"{ 'is-hot': dummyActive }\" :aria-pressed=\"dummyActive\" @click=\"toggleDummy\">{{ dummyActive ? 'Stop auto' : 'Auto pulse' }}</button>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\nexport default {\r\n    data() {\r\n        return {\r\n            newName: '',\r\n            newInterval: 60,\r\n            dummyActive: false\r\n        }\r\n    },\r\n    methods: {\r\n        enrollDevice() {\r\n            if (!this.newName) return;\r\n            this.send({\r\n                topic: \"enroll\",\r\n                payload: { name: this.newName, interval: this.newInterval || 60 }\r\n            });\r\n            this.newName = '';\r\n        },\r\n        enrollTest() {\r\n            this.send({\r\n                topic: \"enroll\",\r\n                payload: { name: \"test-device\", interval: this.newInterval || 60 }\r\n            });\r\n        },\r\n        deleteDevice(name) {\r\n            this.send({\r\n                topic: \"delete\",\r\n                payload: { name: name }\r\n            });\r\n        },\r\n        pulseDevice(name) {\r\n            this.send({\r\n                topic: \"pulse\",\r\n                payload: { name: name }\r\n            });\r\n        },\r\n        toggleDummy() {\r\n            this.dummyActive = !this.dummyActive;\r\n            this.send({\r\n                topic: \"dummy\",\r\n                payload: this.dummyActive\r\n            });\r\n        }\r\n    }\r\n}\r\n</script>\r\n",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "sms-devices",
        "x": 400,
        "y": 100,
        "wires": [
            [
                "func_handle_watchdog_ui",
                "debug_watchdog_ui"
            ]
        ]
    },
    {
        "id": "debug_watchdog_ui",
        "type": "debug",
        "z": "tab_dashboard",
        "name": "Watchdog UI Debug",
        "active": true,
        "tosidebar": true,
        "console": true,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 640,
        "y": 60,
        "wires": []
    },
    {
        "id": "func_handle_watchdog_ui",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Handle Watchdog UI",
        "func": "node.warn('Watchdog UI Command: ' + msg.topic);\nif (msg.topic === 'enroll') {\n    msg.topic = 'sms/gateway/watchdog/enroll';\n    msg.payload = JSON.stringify(msg.payload);\n    return [msg, { payload: 'Enrolling ' + JSON.parse(msg.payload).name, title: 'Watchdog' }];\n} else if (msg.topic === 'delete') {\n    msg.topic = 'sms/gateway/watchdog/delete';\n    msg.payload = JSON.stringify(msg.payload);\n    return [msg, { payload: 'Deleting ' + JSON.parse(msg.payload).name, title: 'Watchdog' }];\n} else if (msg.topic === 'pulse') {\n    msg.topic = 'sms/gateway/watchdog/heartbeat';\n    msg.payload = JSON.stringify(msg.payload);\n    return [msg, { payload: 'Pulse sent for ' + JSON.parse(msg.payload).name, title: 'Watchdog' }];\n} else if (msg.topic === 'dummy') {\n    flow.set('dummy_watchdog_active', msg.payload);\n    return [null, { payload: 'Dummy mode: ' + (msg.payload ? 'ON' : 'OFF'), title: 'Watchdog' }];\n}\nreturn null;",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 140,
        "wires": [
            [
                "mqtt_out_watchdog"
            ],
            [
                "ui_notification_watchdog"
            ]
        ]
    },
    {
        "id": "ui_notification_watchdog",
        "type": "ui-notification",
        "z": "tab_dashboard",
        "group": "ui_group_sms_watchdog",
        "name": "Watchdog Notification",
        "order": 0,
        "width": 0,
        "height": 0,
        "duration": 3,
        "showTimeline": true,
        "position": "top-right",
        "color": "default",
        "x": 880,
        "y": 140,
        "wires": []
    },
