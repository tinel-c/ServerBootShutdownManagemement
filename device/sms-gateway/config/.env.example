# SMS Gateway Environment Variables
# Copy this file to .env and fill in your values

# MQTT Configuration
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# WiFi Configuration (if using WiFi for MQTT)
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password

# GPRS/APN Configuration (if using GPRS)
SMS_GATEWAY_APN=net
SMS_GATEWAY_APN_USER=
SMS_GATEWAY_APN_PASS=

# Device Configuration
SMS_GATEWAY_DEVICE_ID=esp32-sms-gateway
SMS_GATEWAY_DEVICE_NAME=SMS Gateway
