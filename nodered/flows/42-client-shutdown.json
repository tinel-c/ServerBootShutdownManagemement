[
    {
        "id": "ui_group_client_shutdown",
        "type": "ui-group",
        "name": "Client Shutdown Control",
        "page": "ui_page_home",
        "width": "6",
        "height": "1",
        "order": 7,
        "showTitle": true,
        "className": "",
        "visible": "true",
