# ============================================================
# Client PC Monitor Configuration
# ============================================================
# This file contains environment variables for the client monitor
# Copy this file to .env and update with your actual values
#
# IMPORTANT: Never commit the .env file to version control!
# ============================================================

# ------------------------------------------------------------
# MQTT Broker Configuration (REQUIRED)
# ------------------------------------------------------------
# Connection details for the MQTT broker on the automation server

# MQTT broker hostname or IP address
# Example: 192.168.1.100 (automation server IP)
MQTT_BROKER_HOST=localhost

# MQTT broker port (default: 1883 for non-TLS, 8883 for TLS)
MQTT_BROKER_PORT=1883

# MQTT authentication credentials
# These should match the credentials configured on your MQTT broker
# Use a dedicated user for client monitors (not the same as server management)
MQTT_USERNAME=client_monitor
MQTT_PASSWORD=your_mqtt_password_here

# ------------------------------------------------------------
# Client Identification (OPTIONAL)
# ------------------------------------------------------------
# Custom client name (overrides hostname)
# Leave empty to use the computer's hostname automatically
# Useful for giving friendly names to client PCs
# Example: "office-workstation-1" or "john-laptop"
CLIENT_CUSTOM_NAME=

# ------------------------------------------------------------
# Target Server Configuration (OPTIONAL)
# ------------------------------------------------------------
# Which server to monitor for status display in system tray icon
# This should match the MQTT topic prefix of your target server
# Default: dell/t310
# Options: dell/t310, hp/dl360p, or custom server prefix
TARGET_SERVER=dell/t310

# ------------------------------------------------------------
# Heartbeat Configuration (OPTIONAL)
# ------------------------------------------------------------
# How often to send heartbeat messages (in seconds)
# Default: 60 seconds
# Recommended range: 30-300 seconds
HEARTBEAT_INTERVAL=60

# ------------------------------------------------------------
# Logging Configuration (OPTIONAL)
# ------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# Use DEBUG for troubleshooting, INFO for normal operation
LOG_LEVEL=INFO

# Shortcut for DEBUG log level (true/false)
# If true, overrides LOG_LEVEL and sets it to DEBUG
DEBUG=false

# Custom log file path (optional)
# Leave empty to use default: <install_dir>/logs/client_monitor.log
# Example: C:\Logs\client_monitor.log
LOG_FILE=

# ------------------------------------------------------------
# Advanced Configuration (OPTIONAL)
# ------------------------------------------------------------
# Enable system tray icon (true/false)
# Default: true
# Set to false to run in console mode only (useful for servers)
ENABLE_TRAY_ICON=true

# MQTT QoS level (0, 1, or 2)
# Default: 1 (recommended)
# 0 = At most once, 1 = At least once, 2 = Exactly once
MQTT_QOS=1

# MQTT keepalive interval (in seconds)
# Default: 60
# How often to send keepalive packets to maintain connection
MQTT_KEEPALIVE=60

# ------------------------------------------------------------
# TLS/SSL Configuration (OPTIONAL - for secure MQTT)
# ------------------------------------------------------------
# Enable TLS/SSL for MQTT connection
# Default: false
# Set to true if your MQTT broker requires encrypted connections
MQTT_TLS_ENABLED=false

# Path to CA certificate file (required if TLS enabled)
# Example: C:\certs\ca.crt
MQTT_TLS_CA_CERT=

# Path to client certificate file (optional, for mutual TLS)
# Example: C:\certs\client.crt
MQTT_TLS_CLIENT_CERT=

# Path to client key file (optional, for mutual TLS)
# Example: C:\certs\client.key
MQTT_TLS_CLIENT_KEY=

# ------------------------------------------------------------
# Notes
# ------------------------------------------------------------
# 1. After editing this file, save it as .env (remove .example)
# 2. Restart the client monitor for changes to take effect
# 3. For security, ensure .env file has restricted permissions
# 4. Minimum required settings: MQTT_BROKER_HOST, MQTT_USERNAME, MQTT_PASSWORD
# 5. All other settings have sensible defaults

