# Tapo cameras — site example (192.168.2.x LAN)
# Copy relevant lines into config/.env on the automation server.
# Run network scan: python3 scripts/utils/camera_network_scan.py --subnet 192.168.2 --user USER --pass PASS
#
# Last discovery: 2026-07-05 on 192.168.2.0/24
# ONVIF online: .10 C500, .32/.34/.36 C310, .37 C510W
# RTSP-only (enable ONVIF in Tapo app): .59
# Retired IPs: .35, .38 (no longer on network)

CAMERA_1_NAME="Interior curte"
CAMERA_1_IP=192.168.2.37
CAMERA_1_PORT=2020
CAMERA_1_USER=your_camera_account
CAMERA_1_PASS=your_camera_password
CAMERA_1_MQTT_PREFIX="garden/camera/interior"

CAMERA_2_NAME="Poarta mica"
CAMERA_2_IP=192.168.2.10
CAMERA_2_PORT=2020
CAMERA_2_USER=your_camera_account
CAMERA_2_PASS=your_camera_password
CAMERA_2_MQTT_PREFIX="garden/camera/smallGate"

CAMERA_3_NAME="Spate casa"
CAMERA_3_IP=192.168.2.32
CAMERA_3_PORT=2020
CAMERA_3_USER=your_camera_account
CAMERA_3_PASS=your_camera_password
CAMERA_3_MQTT_PREFIX="garden/camera/backyard"

CAMERA_4_NAME="Poarta glisanta 2"
CAMERA_4_IP=192.168.2.34
CAMERA_4_PORT=2020
CAMERA_4_USER=your_camera_account
CAMERA_4_PASS=your_camera_password
CAMERA_4_MQTT_PREFIX="garden/camera/gate2"

CAMERA_5_NAME="Fata casa"
