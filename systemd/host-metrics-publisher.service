[Unit]
Description=Automation host CPU/memory/disk MQTT metrics publisher
Documentation=file:///opt/dell_server_management/docs/HOST_METRICS.md
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dell_server_management
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOST_METRICS_MQTT_PREFIX=system/automation"
Environment="HOST_METRICS_INTERVAL_SEC=15"
ExecStart=/opt/dell_server_management/venv/bin/python3 /opt/dell_server_management/scripts/status/host_metrics_publisher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
