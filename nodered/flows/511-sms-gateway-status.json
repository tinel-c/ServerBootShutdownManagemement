    {
        "id": "func_forward_sms_emergency",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Forward SMS to Emergency",
        "func": "// Forward ALL received SMS to emergency phone number (HARDCODED)\n// Phone numbers in MQTT payload 'to' must be digits-only (no +)\nconst EMERGENCY_PHONE = '40740244845';\n\nconst latest = msg.payload.latest;\nif (!latest || !latest.from || !latest.text) {\n    return null;\n}\n\nconst fromDigits = String(latest.from).replace(/\\D/g, '');\nconst forwardText = 'SMS from ' + (fromDigits || latest.from) + ': ' + latest.text;\nmsg.payload = JSON.stringify({ to: EMERGENCY_PHONE, text: forwardText.substring(0, 160) });\nmsg.topic = 'sms/gateway/command/send';\n\nnode.status({ fill: 'blue', shape: 'dot', text: 'Fwd to emergency' });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 260,
        "wires": [
            [
                "mqtt_out_forward_emergency"
            ]
        ]
    },
