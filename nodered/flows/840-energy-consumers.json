    {
        "id": "mqtt_in_consumers_status",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Consumer status",
        "topic": "energy/consumers/+/status",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
