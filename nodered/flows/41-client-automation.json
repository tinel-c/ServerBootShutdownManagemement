    {
        "id": "ui_template_automation_status",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_clients",
        "name": "Automation Status",
        "order": 2,
        "width": "6",
        "height": "5",
        "format": "<template>\n    <div class=\"automation-container\">\n        <div class=\"automation-header\">\n            <div class=\"header-left\">\n                <h3>Server Automation</h3>\n                <span class=\"client-badge\">{{ status.client_count }} Clients</span>\n            </div>\n            <div class=\"automation-toggle\">\n                <label class=\"switch\">\n                    <input type=\"checkbox\" v-model=\"status.automation_enabled\" @change=\"toggleAutomation\">\n                    <span class=\"slider\"></span>\n                </label>\n                <span class=\"status-text\" :class=\"{active: status.automation_enabled}\">{{ status.automation_enabled ? 'AUTO' : 'MANUAL' }}</span>\n            </div>\n        </div>\n\n        <div class=\"server-status-bar\" :class=\"statusClass\">\n            <span class=\"status-dot\"></span>\n            <div class=\"status-info\">\n                <div class=\"status-row\">\n                    <span class=\"status-label\">DELL T310 (Health):</span>\n                    <span class=\"status-state\">{{ status.metadata.currentState.toUpperCase() }}</span>\n                </div>\n                <div class=\"status-meta\">\n                    Last Sync: {{ formatDelta(status.metadata.lastReportedMs) }}\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"status-grid\">\n            <div class=\"status-card\">\n                <span class=\"status-label-small\">Last Action</span>\n                <span class=\"status-value action\" :class=\"status.last_command.action.toLowerCase().replace(/\\s/g, '-')\">{{ status.last_command.action }}</span>\n            </div>\n            <div class=\"status-card\" :class=\"{highlight: status.shutdown_countdown}\">\n                <span class=\"status-label-small\">{{ status.shutdown_countdown ? 'Shutdown In' : 'When' }}</span>\n                <span class=\"status-value time\" :class=\"{pending: status.shutdown_countdown}\">\n                    {{ status.shutdown_countdown ? status.shutdown_countdown : formatTime(status.last_command.timestamp) }}\n                </span>\n            </div>\n        </div>\n\n        <div class=\"automation-details\">\n             <div class=\"detail-item\">\n                <span class=\"detail-label\">Trigger:</span>\n                <span class=\"detail-value\">{{ status.last_command.details }}</span>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            nowMs: Date.now(),\n            status: {\n                client_count: 0,\n                automation_enabled: true,\n                shutdown_countdown: null,\n                metadata: {\n                    currentState: 'unknown',\n                    lastReportedMs: null\n                },\n                last_command: {\n                    action: \"None\",\n                    timestamp: \"--\",\n                    details: \"Waiting for triggers...\"\n                }\n            }\n        }\n    },\n    mounted() {\n        this.updateInterval = setInterval(() => { \n            this.nowMs = Date.now(); \n            this.$forceUpdate(); \n        }, 1000);\n    },\n    beforeUnmount() {\n        if (this.updateInterval) clearInterval(this.updateInterval);\n    },\n    methods: {\n        toggleAutomation() {\n            this.send({payload: this.status.automation_enabled});\n        },\n        formatDelta(ms) {\n            if (!ms) return 'Never';\n            const seconds = Math.floor((this.nowMs - ms) / 1000);\n            if (seconds < 2) return 'Just now';\n            if (seconds < 60) return `${seconds}s ago`;\n            if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;\n            return new Date(ms).toLocaleTimeString();\n        },\n        formatTime(timestamp) {\n            if (!timestamp || timestamp === '--') return '--';\n            const then = new Date(timestamp);\n            const diffSec = Math.floor((this.nowMs - then) / 1000);\n            if (diffSec < 0) return 'Just now';\n            if (diffSec < 60) return `${diffSec}s ago`;\n            if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;\n            return then.toLocaleTimeString();\n        }\n    },\n    computed: {\n        statusClass() {\n            const state = (this.status.metadata.currentState || 'unknown').toLowerCase();\n            if (state === 'online' || state === 'up') return 'online';\n            if (state === 'offline' || state === 'down') return 'offline';\n            return 'unknown';\n        }\n    },\n    watch: {\n        msg(newMsg) {\n            if (newMsg && newMsg.payload) {\n                this.status = { ...this.status, ...newMsg.payload };\n            }\n        }\n    }\n}\n</script>\n\n<style scoped>\n.automation-container { padding: 15px; background: linear-gradient(135deg, #1a1c2c 0%, #000000 100%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white !important; font-family: 'Inter', 'Segoe UI', sans-serif; box-shadow: 0 10px 30px rgba(0,0,0,0.6); }\n.automation-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.header-left { display: flex; align-items: center; gap: 10px; }\n.automation-header h3 { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: 0.5px; }\n.client-badge { background: rgba(74, 222, 128, 0.15); color: #4ade80; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; border: 1px solid rgba(74, 222, 128, 0.25); }\n.server-status-bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: rgba(255,255,255,0.03); border-radius: 10px; margin-bottom: 15px; border-left: 4px solid #555; }\n.server-status-bar.online { border-left-color: #4ade80; background: rgba(74, 222, 128, 0.05); }\n.server-status-bar.offline { border-left-color: #f87171; background: rgba(248, 113, 113, 0.05); }\n.server-status-bar.unknown { border-left-color: #94a3b8; }\n.status-dot { width: 10px; height: 10px; border-radius: 50%; background: #555; }\n.online .status-dot { background: #4ade80; box-shadow: 0 0 10px #4ade80; }\n.status-info { display: flex; flex-direction: column; flex-grow: 1; }\n.status-row { display: flex; justify-content: space-between; align-items: center; }\n.status-label { font-size: 11px; opacity: 0.5; text-transform: uppercase; letter-spacing: 1px; }\n.status-state { font-weight: 800; font-size: 14px; }\n.online .status-state { color: #4ade80; }\n.offline .status-state { color: #f87171; }\n.status-meta { font-size: 9px; opacity: 0.4; margin-top: 2px; text-align: right; font-family: monospace; }\n.automation-toggle { display: flex; align-items: center; gap: 8px; }\n.switch { position: relative; display: inline-block; width: 34px; height: 18px; }\n.switch input { opacity: 0; width: 0; height: 0; }\n.slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(255,255,255,0.1); transition: 0.4s; border-radius: 20px; }\n.slider:before { position: absolute; content: \"\"; height: 12px; width: 12px; left: 3px; bottom: 3px; background-color: white; transition: 0.4s; border-radius: 50%; }\ninput:checked+ .slider { background-color: #4ade80; }\ninput:checked+ .slider:before { transform: translateX(16px); }\n.status-text { font-weight: bold; font-size: 10px; opacity: 0.5; }\n.status-text.active { opacity: 1; }\n.status-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }\n.status-card { background: rgba(255,255,255,0.04); padding: 10px; border-radius: 8px; display: flex; flex-direction: column; gap: 4px; border: 1px solid rgba(255,255,255,0.04); transition: all 0.3s ease; }\n.status-card.highlight { background: rgba(248, 113, 113, 0.08); border-color: rgba(248, 113, 113, 0.2); }\n.status-label-small { font-size: 9px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.5; }\n.status-value { font-size: 13px; font-weight: 700; }\n.status-value.action.wakeup { color: #4ade80; }\n.status-value.action.recovery-boot { color: #8b5cf6; }\n.status-value.action.grace-period { color: #fbbf24; }\n.status-value.action.shutdown { color: #f87171; }\n.status-value.time { color: #60a5fa; }\n.status-value.time.pending { color: #f87171; font-family: monospace; font-size: 16px; }\n.automation-details { background: rgba(0,0,0,0.25); padding: 8px 12px; border-radius: 6px; font-size: 10px; }\n.detail-item { display: flex; justify-content: space-between; align-items: center; }\n.detail-label { opacity: 0.5; }\n.detail-value { font-weight: 500; }\n</style>",
