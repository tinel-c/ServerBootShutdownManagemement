                "gate_main_cmd_func"
            ]
        ]
    },
    {
        "id": "gate_main_cmd_func",
        "type": "function",
        "z": "gate_main_tab",
        "name": "Build Command & Log",
        "func": "// Log command to context\nconst command = {\n    action: 'relay2_toggle',\n    value: msg.payload,\n    timestamp: new Date().toISOString(),\n    request_id: `gate-relay2-${Date.now()}`\n};\n\n// Store in context\nflow.set('lastCommand', command);\n\n// Add to history (keep last 10)\nlet history = flow.get('commandHistory') || [];\nhistory.unshift(command);\nif (history.length > 10) history = history.slice(0, 10);\nflow.set('commandHistory', history);\n\nnode.log(`Main Gate Relay 2 command: ${msg.payload}`);\n\n// Pass through payload for MQTT\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 220,
        "wires": [
            [
                "gate_main_mqtt_out"
            ]
        ]
    },
