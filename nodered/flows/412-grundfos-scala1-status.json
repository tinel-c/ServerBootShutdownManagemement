[
    {
        "id": "grundfos_scala1_comment",
        "type": "comment",
        "z": "tab_dashboard",
        "name": "═══════════════ GRUNDFOS SCALA1 STATUS DASHBOARD ═══════════════",
        "info": "## Grundfos SCALA1 Status Dashboard\n\n**Flow 412** — BLE booster live metrics.\n\nMQTT: `water/grundfos/scala1/status`\nGlobal: `grundfos_scala1_state`",
        "x": 320,
        "y": 820,
        "wires": []
    },
    {
        "id": "mqtt_in_grundfos_scala1_status",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "Grundfos SCALA1 Status",
        "topic": "water/grundfos/scala1/status",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 200,
        "y": 920,
        "wires": [["func_grundfos_scala1_process"]]
    },
    {
        "id": "func_grundfos_scala1_process",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Process SCALA1 Status",
        "func": "const data = msg.payload;\nif (!data || typeof data !== 'object' || !data.timestamp) {\n    node.warn('Invalid Grundfos SCALA1 status payload');\n    return null;\n}\nlet reportMs;\ntry { reportMs = new Date(data.timestamp).getTime(); } catch (e) { reportMs = Date.now(); }\nflow.set('last_grundfos_scala1_status', data);\nconst metaKey = 'grundfos_scala1_metadata';\nlet meta = flow.get(metaKey) || {};\nmeta.lastReportedMs = reportMs;\nflow.set(metaKey, meta);\nglobal.set('grundfos_scala1_state', { ...data, lastReportedMs: reportMs, receivedAtMs: Date.now() });\nmsg.payload = data;\nmsg.metadata = meta;\nconst run = data.running === true ? 'RUN' : (data.running === false ? 'STOP' : '?');\nnode.status({ fill: data.alarm_code ? 'red' : 'green', shape: 'dot', text: `${run} ${data.pressure_bar != null ? data.pressure_bar + ' bar' : ''}` });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 920,
        "wires": [["template_grundfos_scala1_dashboard"]]
    },
    {
        "id": "inject_grundfos_scala1_refresh",
        "type": "inject",
        "z": "tab_dashboard",
        "name": "Refresh dashboard",
        "props": [{"p": "payload"}],
        "repeat": "60",
        "crontab": "",
        "once": true,
        "onceDelay": 2,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 200,
        "y": 1000,
        "wires": [["func_grundfos_scala1_refresh"]]
    },
    {
        "id": "func_grundfos_scala1_refresh",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Refresh dashboard state",
        "func": "const last = flow.get('last_grundfos_scala1_status');\nif (!last) return null;\nreturn { payload: last, metadata: flow.get('grundfos_scala1_metadata') || {} };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 1000,
        "wires": [["template_grundfos_scala1_dashboard"]]
    },
    {
        "id": "template_grundfos_scala1_dashboard",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_grundfos_scala1",
        "name": "Grundfos SCALA1 Dashboard",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<div style=\"font-family:system-ui,sans-serif;color:#e2e8f0;background:linear-gradient(155deg,#0f172a,#1e3a5f);border-radius:16px;padding:16px;border:1px solid rgba(56,189,248,0.35);\">\n  <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;\">\n    <div>\n      <div style=\"font-size:0.75em;color:#38bdf8;text-transform:uppercase;letter-spacing:0.1em;\">Grundfos SCALA1</div>\n      <div style=\"font-size:1.2em;font-weight:700;\">{{ deviceModel }}</div>\n    </div>\n    <div style=\"font-size:0.85em;color:#94a3b8;\">Updated {{ updateElapsed }} ago</div>\n  </div>\n  <div v-if=\"alarmText\" style=\"background:rgba(239,68,68,0.2);border:1px solid #ef4444;border-radius:8px;padding:10px;margin-bottom:12px;color:#fecaca;\">{{ alarmText }}</div>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;\">\n    <div style=\"background:rgba(255,255,255,0.06);border-radius:12px;padding:14px;text-align:center;\">\n      <div style=\"font-size:0.75em;color:#94a3b8;\">State</div>\n      <div style=\"font-size:1.6em;font-weight:800;color:{{ runColor }};\">{{ runLabel }}</div>\n    </div>\n    <div style=\"background:rgba(255,255,255,0.06);border-radius:12px;padding:14px;text-align:center;\">\n      <div style=\"font-size:0.75em;color:#94a3b8;\">Pressure</div>\n      <div style=\"font-size:1.6em;font-weight:800;\">{{ pressure }}</div>\n    </div>\n    <div style=\"background:rgba(255,255,255,0.06);border-radius:12px;padding:14px;text-align:center;\">\n      <div style=\"font-size:0.75em;color:#94a3b8;\">Flow</div>\n      <div style=\"font-size:1.6em;font-weight:800;\">{{ flow }}</div>\n    </div>\n    <div style=\"background:rgba(255,255,255,0.06);border-radius:12px;padding:14px;text-align:center;\">\n      <div style=\"font-size:0.75em;color:#94a3b8;\">Power</div>\n      <div style=\"font-size:1.6em;font-weight:800;\">{{ power }}</div>\n    </div>\n  </div>\n  <div v-if=\"!msg.payload?.timestamp\" style=\"text-align:center;padding:24px;color:#64748b;\">Waiting for <code>water/grundfos/scala1/status</code></div>\n</div>\n<script>\nexport default {\n  data() { return { now: Date.now(), timer: null }; },\n  mounted() { this.timer = setInterval(() => { this.now = Date.now(); }, 1000); },\n  unmounted() { clearInterval(this.timer); },\n  computed: {\n    p() { return this.msg.payload || {}; },\n    deviceModel() { return this.p.device?.model || 'SCALA1'; },\n    updateElapsed() {\n      const ms = this.msg.metadata?.lastReportedMs;\n      if (!ms) return '—';\n      void this.now;\n      const sec = Math.max(0, Math.floor((this.now - ms) / 1000));\n      return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0');\n    },\n    runLabel() {\n      if (this.p.running === true) return 'RUNNING';\n      if (this.p.running === false) return 'STOPPED';\n      return '—';\n    },\n    runColor() { return this.p.running === true ? '#4ade80' : '#94a3b8'; },\n    pressure() { return this.p.pressure_bar != null ? Number(this.p.pressure_bar).toFixed(2) + ' bar' : '—'; },\n    flow() { return this.p.flow_m3h != null ? Number(this.p.flow_m3h).toFixed(2) + ' m³/h' : '—'; },\n    power() { return this.p.power_w != null ? Math.round(Number(this.p.power_w)) + ' W' : '—'; },\n    alarmText() {\n      if (this.p.alarm_text) return '⚠ ' + this.p.alarm_text;\n      if (this.p.alarm_code) return '⚠ Alarm code: ' + this.p.alarm_code;\n      return '';\n    }\n  }\n};\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 720,
        "y": 960,
        "wires": [[]]
    },
