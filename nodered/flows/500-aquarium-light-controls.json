        "id": "aquarium_store_state",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Store Aquarium State",
        "func": "let state = global.get('aquarium_state') || {};\nstate.light_power = msg.payload;\nstate.lastUpdate = new Date().toISOString();\nglobal.set('aquarium_state', state);\nreturn null;",
