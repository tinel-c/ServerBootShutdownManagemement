[
    {
        "id": "mqtt_in_hp_health",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "HP Health",
        "topic": "hp/dl360p/health",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 920,
        "wires": [
            [
                "ui_template_hp_health"
            ]
        ]
    },
    {
        "id": "ui_template_hp_health",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "ui_group_hp_health",
        "name": "HP Health Monitor",
        "order": 1,
        "width": "6",
        "height": "8",
        "format": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n    <!-- Health Check Cards -->\n    <div v-for=\"check in msg.payload.checks\" :key=\"check.unique_key\" \n         :style=\"getCheckCardStyle(check.status)\" \n         style=\"margin-bottom: 12px; padding: 14px; border-radius: 8px; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.3);\">\n        \n        <!-- Check Header -->\n        <div style=\"display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;\">\n            <div style=\"flex: 1;\">\n                <div style=\"display: flex; align-items: center; gap: 8px; margin-bottom: 4px;\">\n                    <span :style=\"getStatusIconStyle(check.status)\">{{getStatusIcon(check.status)}}</span>\n                    <h4 style=\"margin: 0; color: #fff; font-size: 1em; font-weight: 600;\">{{check.name}}</h4>\n                    <span v-if=\"check.slug\" style=\"font-size: 0.7em; color: #999; font-family: monospace; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;\">{{check.slug}}</span>\n                </div>\n                <div v-if=\"check.desc\" style=\"font-size: 0.8em; color: #bbb; margin-top: 4px;\">{{check.desc}}</div>\n                <div v-if=\"check.tags\" style=\"margin-top: 6px;\">\n                    <span v-for=\"tag in check.tags.split(',')\"\n                          style=\"display: inline-block; font-size: 0.7em; color: #4caf50; background: rgba(76, 175, 80, 0.2); padding: 2px 8px; border-radius: 10px; margin-right: 4px;\">\n                        #{{tag.trim()}}\n                    </span>\n                </div>\n            </div>\n            <div :style=\"getStatusPillStyle(check.status)\" style=\"padding: 6px 14px; border-radius: 16px; font-size: 0.75em; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap;\">\n                {{check.status}}\n            </div>\n        </div>\n\n        <!-- Statistics Grid -->\n        <div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 10px;\">\n            <div style=\"background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px;\">\n                <div style=\"font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;\">Total Pings</div>\n                <div style=\"font-size: 1.1em; color: #4caf50; font-weight: bold; font-family: monospace;\">{{formatNumber(check.n_pings)}}</div>\n            </div>\n            <div style=\"background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px;\">\n                <div style=\"font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;\">Grace Period</div>\n                <div style=\"font-size: 1.1em; color: #2196f3; font-weight: bold; font-family: monospace;\">{{check.grace}}s</div>\n            </div>\n            <div style=\"background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px;\">\n                <div style=\"font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;\">Timeout</div>\n                <div style=\"font-size: 1.1em; color: #ff9800; font-weight: bold; font-family: monospace;\">{{check.timeout}}s</div>\n            </div>\n            <div style=\"background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px;\">\n                <div style=\"font-size: 0.7em; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;\">Manual Resume</div>\n                <div style=\"font-size: 1.1em; font-weight: bold; font-family: monospace;\" :style=\"{color: check.manual_resume ? '#ff9800' : '#4caf50'}\">\n                    {{check.manual_resume ? 'REQUIRED' : 'AUTO'}}\n                </div>\n            </div>\n        </div>\n\n        <!-- Timing Information -->\n        <div style=\"background: rgba(0,0,0,0.2); padding: 10px; border-radius: 6px; margin-bottom: 8px;\">\n            <div style=\"display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; font-size: 0.75em;\">\n                <span style=\"color: #888;\">⏱️ Last Ping:</span>\n                <span style=\"color: #4caf50; font-family: monospace; font-weight: 500;\">{{formatDateTime(check.last_ping)}}</span>\n                \n                <span style=\"color: #888;\">⏭️ Next Ping:</span>\n                <span style=\"color: #2196f3; font-family: monospace; font-weight: 500;\">{{formatDateTime(check.next_ping)}}</span>\n                \n                <span style=\"color: #888;\">⏳ Time Until:</span>\n                <span style=\"color: #ff9800; font-family: monospace; font-weight: 500;\">{{getTimeUntilNextPing(check.next_ping)}}</span>\n            </div>\n        </div>\n\n        <!-- Optional Fields -->\n        <div v-if=\"check.methods || check.subject || check.started\" style=\"margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.1);\">\n            <div style=\"display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.7em;\">\n                <div v-if=\"check.methods\" style=\"background: rgba(33, 150, 243, 0.2); color: #2196f3; padding: 4px 8px; border-radius: 4px;\">\n                    📡 {{check.methods}}\n                </div>\n                <div v-if=\"check.subject\" style=\"background: rgba(156, 39, 176, 0.2); color: #9c27b0; padding: 4px 8px; border-radius: 4px;\">\n                    📧 {{check.subject}}\n                </div>\n                <div v-if=\"check.started\" style=\"background: rgba(76, 175, 80, 0.2); color: #4caf50; padding: 4px 8px; border-radius: 4px;\">\n                    ▶️ Started\n                </div>\n            </div>\n        </div>\n\n        <!-- Badge URL -->\n        <div v-if=\"check.badge_url\" style=\"margin-top: 10px; text-align: center;\">\n            <a :href=\"check.badge_url\" target=\"_blank\" style=\"font-size: 0.7em; color: #2196f3; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; background: rgba(33, 150, 243, 0.1); border-radius: 4px; transition: background 0.2s;\">\n                🔗 View Badge\n            </a>\n        </div>\n    </div>\n\n    <!-- No Checks Message -->\n    <div v-if=\"!msg.payload.checks || msg.payload.checks.length === 0\" style=\"text-align: center; padding: 40px 20px; background: rgba(255, 193, 7, 0.1); border-radius: 8px; border: 2px dashed #ff9800;\">\n        <div style=\"font-size: 3em; margin-bottom: 10px;\">⚠️</div>\n        <div style=\"color: #ff9800; font-size: 1.1em; font-weight: 600;\">No Health Checks Available</div>\n        <div style=\"color: #999; font-size: 0.85em; margin-top: 8px;\">Waiting for health data from server...</div>\n    </div>\n</div>\n\n<script>\nexport default {\n    data() {\n        return {\n            now: Date.now(),\n            timer: null\n        }\n    },\n    mounted() {\n        this.timer = setInterval(() => {\n            this.now = Date.now()\n        }, 1000)\n    },\n    unmounted() {\n        clearInterval(this.timer)\n    },\n    methods: {\n        formatDateTime(datetime) {\n            if (!datetime) return 'N/A'\n            const date = new Date(datetime)\n            return date.toLocaleString('en-US', {\n                month: 'short',\n                day: 'numeric',\n                hour: '2-digit',\n                minute: '2-digit',\n                second: '2-digit'\n            })\n        },\n        formatDelta(ms) {\n            if (!ms) return 'Never'\n            const seconds = Math.floor((this.now - ms) / 1000)\n            if (seconds < 2) return 'Just now'\n            if (seconds < 60) return `${seconds}s ago`\n            if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`\n            if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`\n            return new Date(ms).toLocaleDateString()\n        },\n        formatNumber(num) {\n            if (!num) return '0'\n            return num.toLocaleString()\n        },\n        getTimeUntilNextPing(nextPing) {\n            if (!nextPing) return 'N/A'\n            const next = new Date(nextPing).getTime()\n            const diff = Math.floor((next - this.now) / 1000)\n            if (diff < 0) return 'Overdue!'\n            if (diff < 60) return `${diff}s`\n            if (diff < 3600) return `${Math.floor(diff / 60)}m ${diff % 60}s`\n            return `${Math.floor(diff / 3600)}h ${Math.floor((diff % 3600) / 60)}m`\n        },\n        getStatusIcon(status) {\n            if (status === 'up') return '✅'\n            if (status === 'down') return '❌'\n            return '⚠️'\n        },\n        getStatusIconStyle(status) {\n            return {\n                fontSize: '1.2em',\n                filter: status === 'up' ? 'drop-shadow(0 0 4px #4caf50)' : \n                        status === 'down' ? 'drop-shadow(0 0 4px #f44336)' : \n                        'drop-shadow(0 0 4px #ff9800)'\n            }\n        },\n        getCheckCardStyle(status) {\n            const baseStyle = {\n                background: 'linear-gradient(135deg, rgba(30, 30, 30, 0.95), rgba(40, 40, 40, 0.95))'\n            }\n            if (status === 'up') {\n                return { ...baseStyle, borderLeft: '4px solid #4caf50' }\n            } else if (status === 'down') {\n                return { ...baseStyle, borderLeft: '4px solid #f44336' }\n            } else {\n                return { ...baseStyle, borderLeft: '4px solid #ff9800' }\n            }\n        },\n        getStatusPillStyle(status) {\n            if (status === 'up') {\n                return { background: '#4caf50', color: '#fff', boxShadow: '0 0 10px rgba(76, 175, 80, 0.5)' }\n            } else if (status === 'down') {\n                return { background: '#f44336', color: '#fff', boxShadow: '0 0 10px rgba(244, 67, 54, 0.5)' }\n            } else {\n                return { background: '#ff9800', color: '#fff', boxShadow: '0 0 10px rgba(255, 152, 0, 0.5)' }\n            }\n        }\n    }\n}\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 420,
        "y": 920,
        "wires": [
            []
        ]
    }
]
