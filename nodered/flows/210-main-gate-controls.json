                "gate_main_trigger"
            ]
        ]
    },
    {
        "id": "gate_main_trigger",
        "type": "trigger",
        "z": "gate_main_tab",
        "name": "Pulse (1 second)",
        "op1": "ON",
        "op2": "OFF",
        "op1type": "str",
        "op2type": "str",
        "duration": "1",
        "extend": false,
        "overrideDelay": false,
        "units": "s",
        "reset": "",
        "bytopic": "all",
        "topic": "topic",
