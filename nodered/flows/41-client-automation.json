    {
        "id": "inject_grace_timer",
        "type": "inject",
        "z": "tab_dashboard",
        "name": "Watchdog & Grace Monitor 1s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "1",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 1100,
        "wires": [
            [
                "func_process_grace_timer"
            ]
        ]
    },
    {
        "id": "func_process_grace_timer",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Watchdog & Grace Loop",
        "func": "const now = new Date();\nconst deadline = flow.get('shutdown_deadline');\n// Read from LOCAL flow context (derived from health)\nconst metadata = flow.get('status_metadata_dell_t310_status') || { currentState: 'unknown' };\nconst serverState = (metadata.currentState || 'unknown').toLowerCase();\nconst lastReported = metadata.lastReportedMs ? (now.getTime() - metadata.lastReportedMs) / 1000 : 9999;\n\n// Get client count for idle monitoring\nconst clients = flow.get('clients') || {};\nconst clientCount = Object.keys(clients).length;\nconst automationEnabled = flow.get('client_automation_enabled') !== false;\n\n// --- Part 1: Status Watchdog ---\nlet unknownDuration = context.get('unknown_duration') || 0;\n\n// Trigger if state is unknown OR if heartbeat is lost for 45s\nif (serverState === 'unknown' || lastReported > 45) {\n    unknownDuration += 1;\n    context.set('unknown_duration', unknownDuration);\n    \n    if (unknownDuration >= 60) {\n        context.set('unknown_duration', 0);\n        const timestamp = now.toISOString();\n        flow.set('last_command', {\n            action: \"Recovery Boot\",\n            timestamp: timestamp,\n            details: \"Server health lost for 60s (WOL)\"\n        });\n        \n        msg.payload = { action: 'boot', method: 'wol' };\n        node.warn(\"Watchdog recovery triggered (Health checks lost)\");\n        node.send([{ payload: msg.payload }, { payload: \"refresh\" }]);\n        return null;\n    }\n} else {\n    context.set('unknown_duration', 0);\n}\n\n// --- Part 2: Idle Server Monitor (Reactive Shutdown) ---\nif (automationEnabled && (serverState === 'up' || serverState === 'online') && clientCount === 0 && !deadline) {\n    // Initiate grace period if server is UP but IDLE\n    const GRACE_SECONDS = 300;\n    const newDeadline = new Date(Date.now() + GRACE_SECONDS * 1000).toISOString();\n    flow.set('shutdown_deadline', newDeadline);\n    flow.set('last_command', {\n        action: \"Grace Period\",\n        timestamp: now.toISOString(),\n        details: \"Auto-shutdown (Server up but idle)\"\n    });\n    node.status({fill: \"yellow\", shape: \"ring\", text: \"Idle grace started\"});\n    node.send([null, { payload: \"refresh\" }]);\n    return null;\n}\n\n// --- Part 3: Shutdown Grace Countdown ---\nif (deadline) {\n    // Safety: Cancel shutdown if clients are present\n    if (clientCount > 0) {\n        flow.set('shutdown_deadline', null);\n        flow.set('last_command', {\n            action: \"Cancelled\",\n            timestamp: now.toISOString(),\n            details: \"Shutdown aborted (Client connected)\"\n        });\n        node.status({fill: \"green\", shape: \"dot\", text: \"Shutdown cancelled\"});\n        node.send([null, { payload: \"refresh\" }]);\n        return null;\n    }\n\n    const target = new Date(deadline);\n    const remaining = Math.floor((target - now) / 1000);\n\n    if (remaining <= 0) {\n        flow.set('shutdown_deadline', null);\n        const timestamp = now.toISOString();\n        flow.set('last_command', {\n            action: \"Shutdown\",\n            timestamp: timestamp,\n            details: \"Proxmox graceful shutdown executed\"\n        });\n        \n        node.status({fill: \"red\", shape: \"dot\", text: \"Executing shutdown\"});\n        node.send([{ payload: { action: 'shutdown', type: 'graceful' } }, { payload: \"refresh\" }]);\n        return null;\n    }\n    \n    node.status({fill: \"blue\", shape: \"dot\", text: `${remaining}s remaining`});\n    node.send([null, { payload: \"refresh\" }]);\n    return null;\n}\n\nif (serverState === 'unknown' || lastReported > 30) {\n    node.status({fill: \"grey\", shape: \"ring\", text: `Health Lost: ${unknownDuration}s`});\n    node.send([null, { payload: \"refresh\" }]);\n    return null;\n}\n\nreturn null;",
