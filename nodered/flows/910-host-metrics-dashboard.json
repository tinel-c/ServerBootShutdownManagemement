    {
        "id": "host_metrics_refresh_fn",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Replay last snapshot",
        "func": "const last = flow.get('last_host_metrics');\nif (!last) return null;\nreturn {\n    payload: {\n        ...last,\n        fine_chart: flow.get('host_fine_history') || [],\n        month_chart: flow.get('host_month_history') || []\n    }\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 220,
