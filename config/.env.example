# HealthChecks.io Configuration
HEALTHCHECKS_API_KEY=hcr_mOx7fm5xxxxxxxxxxxxxxxxxx
T310_HEALTHCHECKS="nextcloud"
DL360P_HEALTHCHECKS="dl360p_server"
MEDIA_SERVER_HEALTHCHECKS="media_server"

# Media Server (Ubuntu barebone @ 192.168.2.185)
MEDIA_SERVER_HOST=192.168.2.185
MEDIA_SERVER_SSH_USER=tinel
MEDIA_SERVER_SSH_KEY=/home/tinel/.ssh/media_server_192_168_2_185_ed25519
MEDIA_SERVER_TUYA_DEVICE_ID=your_tuya_device_id
MEDIA_SERVER_TUYA_LOCAL_KEY=your_tuya_local_key
MEDIA_SERVER_TUYA_IP=192.168.2.xxx
MEDIA_SERVER_TUYA_VERSION=3.3
# Optional DPS overrides (defaults: power=1, reset=2, force_reset=3, status=101)
MEDIA_SERVER_TUYA_DPS_POWER=
MEDIA_SERVER_TUYA_DPS_RESET=
MEDIA_SERVER_TUYA_DPS_FORCE_RESET=
MEDIA_SERVER_TUYA_DPS_STATUS=
MEDIA_SERVER_HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid-here

# Optional one-time: used by finish_remote_setup.sh for ssh-copy-id, then removed from .env
# MEDIA_SERVER_SSH_PASSWORD=your_media_server_password

# Tuya IoT Cloud — link all Smart Life devices (see docs/TUYA_ACCOUNT_LINK.md)
# TUYA_ACCESS_ID=your_access_id
# TUYA_ACCESS_SECRET=your_access_secret
# TUYA_API_REGION=eu
#
# All devices (after sync): python3 scripts/tuya/sync_devices.py apply-env
# See config/tuya.env.example for TUYA_DEVICE_N_* layout (NAME, ID, LOCAL_KEY, IP, VERSION, PRODUCT_ID)

