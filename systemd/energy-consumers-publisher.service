[Unit]
Description=Tuya and Tasmota energy consumers MQTT publisher
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dell_server_management
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/dell_server_management/device/energy-consumers/lib:/opt/dell_server_management/scripts/utils"
ExecStart=/opt/dell_server_management/venv/bin/python3 /opt/dell_server_management/device/energy-consumers/scripts/tuya_consumers_publisher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
