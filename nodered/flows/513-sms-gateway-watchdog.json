    {
        "id": "func_send_dummy_heartbeat",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Send Dummy Heartbeat",
        "func": "if (flow.get('dummy_watchdog_active')) {\n    msg.topic = 'sms/gateway/watchdog/heartbeat';\n    msg.payload = JSON.stringify({ name: 'dummy-device' });\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 200,
