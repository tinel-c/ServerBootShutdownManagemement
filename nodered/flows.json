    {
        "id": "func_log_accumulator",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Accumulate Logs",
        "func": "var logs = flow.get(\"dashboard_logs\") || [];\nvar entry = msg.payload;\n\n// Add timestamp if missing\nif (!entry.timestamp) {\n    entry.timestamp = new Date().toLocaleTimeString();\n}\n\n// Determine style class based on level\nentry.class = \"text-info\";\nif (entry.level === \"WARNING\") entry.class = \"text-warning\";\nif (entry.level === \"ERROR\" || entry.level === \"CRITICAL\") entry.class = \"text-danger\";\nif (entry.success === false) entry.class = \"text-danger\"; // Legacy fallback\nif (entry.success === true) entry.class = \"text-success\";\n\n// Normalize source\nentry.source = entry.service || entry.action || \"SYSTEM\";\n\nlogs.push(entry);\n\n// Keep last 50\nif (logs.length > 50) {\n    logs = logs.slice(-50);\n}\n\nflow.set(\"dashboard_logs\", logs);\n\n// We must return the ARRAY for the template to loop\nmsg.payload = logs;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 720,
        "wires": [
