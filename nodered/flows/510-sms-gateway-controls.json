    },
    {
        "id": "func_store_sms_allowed_phones",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Store allowed phones",
        "func": "// Parse comma-separated phone numbers and store for SMS interface (514)\nconst raw = (msg.payload != null ? String(msg.payload) : '').trim();\nconst list = raw\n    .split(',')\n    .map(s => s.trim())\n    .filter(s => s.length > 0);\nflow.set('sms_allowed_phones', list);\nif (list.length > 0) {\n    node.status({ fill: 'green', shape: 'dot', text: list.length + ' allowed' });\n} else {\n    node.status({ fill: 'grey', shape: 'ring', text: 'allow all' });\n}\nreturn null;",
        "outputs": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 60,
        "wires": []
    },
