    {
        "id": "func_dell_status_metadata",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Dell Status Metadata",
        "func": "let metadataKey = \"status_metadata_\" + msg.topic.replace(/\\//g, \"_\");\nlet metadata = flow.get(metadataKey) || {\n    lastReported: \"Never\",\n    lastChanged: \"Never\",\n    previousState: \"Unknown\",\n    currentState: \"Unknown\"\n};\n\nlet newState = msg.payload.server_state;\nlet incomingTimestamp = msg.payload.timestamp;\n\n// Format timestamp for readability if it exists\nlet reportTime = incomingTimestamp ? new Date(incomingTimestamp).toLocaleString() : new Date().toLocaleString();\n\nmetadata.lastReported = reportTime;\n\nif (newState !== metadata.currentState) {\n    metadata.previousState = metadata.currentState;\n    metadata.currentState = newState;\n    metadata.lastChanged = reportTime;\n}\n\nflow.set(metadataKey, metadata);\nmsg.metadata = metadata;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 300,
        "wires": [
            [
                "template_dell_status"
            ]
        ]
    },
