    {
        "id": "trigger_sms_heartbeat",
        "type": "trigger",
        "z": "tab_dashboard",
        "name": "SMS Heartbeat Timeout",
        "op1": "",
        "op2": "offline",
        "op1type": "nul",
        "op2type": "str",
        "duration": "10",
        "extend": true,
        "overrideDelay": false,
        "units": "min",
        "reset": "",
        "bytopic": "all",
        "topic": "topic",
        "outputs": 1,
        "x": 400,
